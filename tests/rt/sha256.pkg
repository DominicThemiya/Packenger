use std
use rt/sha256
use rt/test
use rt/str

fn rep(s: str, n: int) -> str
  let b = sb_new()
  for i = 1 to n
    sb_add(b, s)
  end
  return sb_str(b)
end

test_str(sha256_hex(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "length 0")
test_str(sha256_hex("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "length 3")
test_str(sha256_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1", "length 56")
test_str(sha256_hex(rep("a", 55)), "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318", "length 55")
test_str(sha256_hex(rep("a", 56)), "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a", "length 56")
test_str(sha256_hex(rep("a", 64)), "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb", "length 64")
test_str(sha256_hex(rep("packenger", 111)), "2c29f8880a83697b5b67947a997b2bee8a010ecf8296b3e53e29912a76257b10", "length 999")

return test_done()
