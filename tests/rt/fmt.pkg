use std
use rt/fmt
use rt/test

test_str(fmt_size(0), "0 B", "size zero")
test_str(fmt_size(1023), "1023 B", "size bytes")
test_str(fmt_size(1024), "1.0 KB", "size 1 KB")
test_str(fmt_size(1536), "1.5 KB", "size KB")
test_str(fmt_size(5 * 1048576 + 524288), "5.5 MB", "size MB")
test_str(fmt_size(3 * 1073741824), "3.0 GB", "size GB")
test_str(fmt_commas(0), "0", "commas zero")
test_str(fmt_commas(999), "999", "commas short")
test_str(fmt_commas(1000), "1,000", "commas thousand")
test_str(fmt_commas(1234567), "1,234,567", "commas million")
test_str(fmt_commas(-12345), "-12,345", "commas negative")
test_str(fmt_percent(16, 100), "16%", "percent")
test_str(fmt_percent(1, 3), "33%", "percent truncates")
test_str(fmt_percent(5, 0), "0%", "percent of nothing")
test_str(fmt_fixed(1962, 1), "196.2", "fixed")
test_str(fmt_fixed(5, 2), "0.05", "fixed pads")
test_str(fmt_fixed(-5, 2), "-0.05", "fixed negative")
test_str(fmt_fixed(42, 0), "42", "fixed no places")
test_str(fmt_hex(0), "0", "hex zero")
test_str(fmt_hex(255), "ff", "hex")
test_str(fmt_hex(3735928559), "deadbeef", "hex word")
test_str(fmt_hex(-1), "ffffffffffffffff", "hex negative")
test_str(fmt_bar(3, 4, 8), "██████", "bar")
test_str(fmt_bar(1, 1000, 8), "█", "bar at least one")
test_str(fmt_bar(0, 10, 8), "", "bar empty")
return test_done()
