use std
use rt/os
use rt/str
use rt/vec
use rt/io
use rt/test

test_true(os_getenv("PATH") != "", "PATH is set")
test_str(os_getenv("PACKENGER_SURELY_UNSET_VARIABLE"), "", "an unset variable")
test_true(vec_len(os_environ()) > 0, "the environment")
test_true(str_ends(os_find("sh"), "/sh"), "find sh on PATH")
test_str(os_find("./x/y"), "./x/y", "a path is used as is")
test_str(os_find("packenger-no-such-command"), "", "unknown command")

let none = vec_new()
test_int(os_run("true", none), 0, "true exits 0")
test_int(os_run("false", none), 1, "false exits 1")
let args = vec_new()
vec_push(args, "-c" as int)
vec_push(args, "exit 7" as int)
test_int(os_run("sh", args), 7, "an exit status")
let kill = vec_new()
vec_push(kill, "-c" as int)
vec_push(kill, "kill -9 $$" as int)
test_int(os_run("sh", kill), 137, "killed by a signal")
test_int(os_run("packenger-no-such-command", none), -1, "a command that can't start")
let out = ""
let echo = vec_new()
vec_push(echo, "-c" as int)
vec_push(echo, "echo out; echo err >&2; exit 3" as int)
test_int(os_run_output("sh", echo, &out), 3, "captured status")
test_str(out, "out\nerr\n", "captured stdout and stderr")
let pwd = vec_new()
vec_push(pwd, "-c" as int)
vec_push(pwd, "pwd" as int)
test_int(os_run_in("/tmp", "sh", pwd, &out), 0, "run in a directory")
test_str(out, "/tmp\n", "the working directory")
test_int(os_run_output("pwd", none, &out), 0, "pwd")
test_str(str_concat(os_cwd(), "\n"), out, "os_cwd")
// a directory tree to remove
let tree = vec_new()
vec_push(tree, "-c" as int)
vec_push(tree, "d=/tmp/rt-os-tree-$PPID; mkdir -p $d/sub/deeper && touch $d/a $d/sub/b $d/sub/deeper/c && echo $d" as int)
test_int(os_run_output("sh", tree, &out), 0, "made a tree")
let dir = str_slice(out, 0, len(out) - 1)
test_true(io_exists(str_concat(dir, "/sub/deeper/c")), "the tree exists")
test_true(os_remove_all(dir), "removed the tree")
test_true(!io_exists(dir), "the tree is gone")
test_true(!os_remove_all(dir), "removing it again fails")
return test_done()
