use std
use rt/str
use rt/test

test_str(str_concat("pack", "enger"), "packenger", "concat")
test_str(str_concat("", ""), "", "concat empty")
let s = "hello, world"
test_str(str_slice(s, 0, 5), "hello", "slice")
test_str(str_slice(s, 7, 100), "world", "slice clamps the end")
test_str(str_slice(s, 5, 2), "", "empty slice")
test_true(str_starts(s, "hello"), "starts")
test_true(!str_starts(s, "world"), "doesn't start")
test_true(str_ends(s, "world"), "ends")
test_true(!str_ends("ab", "abc"), "longer suffix")
test_int(str_find(s, "o", 0), 4, "find")
test_int(str_find(s, "o", 5), 8, "find from")
test_int(str_find(s, "xyz", 0), -1, "not found")
test_int(str_find(s, "", 3), 3, "find empty")
test_int(str_find_byte(s, ',', 0), 5, "find byte")
test_true(str_cmp("abc", "abd") < 0, "cmp less")
test_true(str_cmp("b", "abc") > 0, "cmp greater")
test_int(str_cmp("same", "same"), 0, "cmp equal")
test_true(str_cmp("ab", "abc") < 0, "cmp prefix")
test_true(str_hash("a") != str_hash("b"), "hash differs")
test_int(str_hash("x"), str_hash(str_concat("", "x")), "hash is by content")
test_str(str_from_int(0), "0", "zero")
test_str(str_from_int(-1234), "-1234", "negative")
test_str(str_from_int(9223372036854775807), "9223372036854775807", "max")
test_str(str_from_int(-9223372036854775807 - 1), "-9223372036854775808", "min")
let ok = false
test_int(str_parse_int("-305", &ok), -305, "parse")
test_true(ok, "parse ok")
test_int(str_parse_int("-9223372036854775808", &ok), -9223372036854775807 - 1, "parse min")
str_parse_int("12a", &ok)
test_true(!ok, "parse rejects junk")
str_parse_int("-", &ok)
test_true(!ok, "parse rejects a lone minus")
test_str(str_pad("ab", 4), "ab  ", "pad")
test_str(str_lpad("ab", 4), "  ab", "lpad")
test_str(str_pad("abcdef", 4), "abcdef", "pad never cuts")

let b = sb_new()
for i = 1 to 100
  sb_int(b, i)
  sb_byte(b, ',')
end
let built = sb_str(b)
test_true(str_starts(built, "1,2,3,"), "builder start")
test_true(str_ends(built, ",99,100,"), "builder end after growing")
test_int(sb_len(b), len(built), "builder length")
sb_clear(b)
sb_add(b, "x = ")
sb_int(b, 7)
test_str(sb_str(b), "x = 7", "builder reuse")
return test_done()
