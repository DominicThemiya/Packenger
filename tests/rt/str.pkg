use std
use rt/str
use rt/test

test_str(str_concat("pack", "enger"), "packenger", "concat")
test_str(str_concat("", ""), "", "concat empty")
let s = "hello, world"
test_str(str_slice(s, 0, 5), "hello", "slice")
test_str(str_slice(s, 7, 100), "world", "slice clamps the end")
test_str(str_slice(s, 5, 2), "", "empty slice")
test_true(str_starts(s, "hello"), "starts")
test_true(!str_starts(s, "world"), "doesn't start")
test_true(str_ends(s, "world"), "ends")
test_true(!str_ends("ab", "abc"), "longer suffix")
test_int(str_find(s, "o", 0), 4, "find")
test_int(str_find(s, "o", 5), 8, "find from")
test_int(str_find(s, "xyz", 0), -1, "not found")
test_int(str_find(s, "", 3), 3, "find empty")
test_int(str_find_byte(s, ',', 0), 5, "find byte")
test_true(str_cmp("abc", "abd") < 0, "cmp less")
test_true(str_cmp("b", "abc") > 0, "cmp greater")
test_int(str_cmp("same", "same"), 0, "cmp equal")
test_true(str_cmp("ab", "abc") < 0, "cmp prefix")
test_true(str_hash("a") != str_hash("b"), "hash differs")
test_int(str_hash("x"), str_hash(str_concat("", "x")), "hash is by content")
test_str(str_from_int(0), "0", "zero")
test_str(str_from_int(-1234), "-1234", "negative")
test_str(str_from_int(9223372036854775807), "9223372036854775807", "max")
test_str(str_from_int(-9223372036854775807 - 1), "-9223372036854775808", "min")
let ok = false
test_int(str_parse_int("-305", &ok), -305, "parse")
test_true(ok, "parse ok")
test_int(str_parse_int("-9223372036854775808", &ok), -9223372036854775807 - 1, "parse min")
test_int(str_parse_int("9223372036854775807", &ok), 9223372036854775807, "parse max")
test_true(ok, "parse max ok")
str_parse_int("9223372036854775808", &ok)
test_true(!ok, "parse rejects overflow")
str_parse_int("-9223372036854775809", &ok)
test_true(!ok, "parse rejects negative overflow")
str_parse_int("99999999999999999999", &ok)
test_true(!ok, "parse rejects a long number")
str_parse_int("12a", &ok)
test_true(!ok, "parse rejects junk")
str_parse_int("-", &ok)
test_true(!ok, "parse rejects a lone minus")
test_str(str_pad("ab", 4), "ab  ", "pad")
test_str(str_lpad("ab", 4), "  ab", "lpad")
test_str(str_pad("abcdef", 4), "abcdef", "pad never cuts")

let b = sb_new()
for i = 1 to 100
  sb_int(b, i)
  sb_byte(b, ',')
end
let built = sb_str(b)
test_true(str_starts(built, "1,2,3,"), "builder start")
test_true(str_ends(built, ",99,100,"), "builder end after growing")
test_int(sb_len(b), len(built), "builder length")
sb_clear(b)
sb_add(b, "x = ")
sb_int(b, 7)
test_str(sb_str(b), "x = 7", "builder reuse")
sb_clear(b)
sb_hex(b, 10)
sb_hex(b, 255)
test_str(sb_str(b), "0aff", "builder hex")

// splitting, joining, trimming, quoting
test_str(str_concat3("a", "b", "c"), "abc", "concat3")
test_str(str_concat4("a", "b", "c", "d"), "abcd", "concat4")
test_true(str_has("packenger", "ken"), "has")
test_true(!str_has("pack", "x"), "hasn't")
test_true(str_is_space('\t') && str_is_space(12 as u8) && !str_is_space('a'), "is space")
test_str(str_trim("  \t hi there \n"), "hi there", "trim")
test_str(str_trim("   "), "", "trim to nothing")
test_str(str_rtrim("http://x//", '/'), "http://x", "rtrim")
test_str(str_trim_prefix("https://a", "https://"), "a", "trim prefix")
test_str(str_trim_prefix("ftp://a", "https://"), "ftp://a", "trim missing prefix")
test_str(str_replace("a-b-c", "-", "+"), "a+b+c", "replace")
test_str(str_replace("aaa", "aa", "b"), "ba", "replace without overlap")
test_str(str_replace("abc", "", "x"), "abc", "replace nothing")
let parts = str_split("a,,b", ',')
test_int(vec_len(parts), 3, "split keeps empty pieces")
test_str(vec_get_str(parts, 1), "", "split empty piece")
test_int(vec_len(str_split("", ',')), 1, "split of nothing")
let fields = str_fields("  use  std\t// note ")
test_int(vec_len(fields), 4, "fields")
test_str(vec_get_str(fields, 3), "note", "fields last")
test_int(vec_len(str_fields(" \t ")), 0, "no fields")
test_str(str_join(fields, "|"), "use|std|//|note", "join")
test_str(str_join_from(fields, 2, " "), "// note", "join from")
test_str(str_join(str_fields(""), ","), "", "join nothing")
test_str(str_quote("say \"hi\"\n"), "\"say \\\"hi\\\"\\n\"", "quote escapes")
test_str(str_quote("tab\there"), "\"tab\\there\"", "quote tab")
test_str(str_quote("\x01é"), "\"\\x01é\"", "quote control byte, keep UTF-8")
return test_done()
