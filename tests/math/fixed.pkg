use std
use rt/test
use math

let ok = false
test_int(fx(3), 3000000, "fx")
test_int(fx_parse("2.5", &ok), 2500000, "parse")
test_true(ok, "parse ok")
test_int(fx_parse("-12.375", &ok), -12375000, "parse negative")
test_int(fx_parse("0.1234567", &ok), 123456, "parse truncates past six places")
test_int(fx_parse("+7", &ok), 7000000, "parse whole")
fx_parse("1.", &ok)
test_true(!ok, "parse 1.")
fx_parse(".5", &ok)
test_true(!ok, "parse .5")
fx_parse("1e3", &ok)
test_true(!ok, "parse exponent")
fx_parse("99999999999999", &ok)
test_true(!ok, "parse too big")
let price = fx_parse("19.99", &ok)
test_str(fx_str(fx_mul(price, fx(3))), "59.97", "mul")
test_str(fx_str(fx_mul(fx_parse("-1.5", &ok), fx_parse("2.25", &ok))), "-3.375", "mul negative")
test_str(fx_str(fx_mul(fx(3000000), fx(3000))), "9000000000", "mul large")
test_str(fx_str(fx_div(fx(1), fx(3))), "0.333333", "div")
test_str(fx_str(fx_div(fx(-1), fx(3))), "-0.333333", "div negative")
test_str(fx_str(fx_div(fx(22), fx(7))), "3.142857", "div 22/7")
test_str(fx_str(fx_div(fx(1000000), fx_parse("0.001", &ok))), "1000000000", "div by a small number")
test_str(fx_str(fx_ratio(1, 4)), "0.25", "ratio")
test_str(fx_str(fx_sqrt(fx(2))), "1.414213", "sqrt 2")
test_str(fx_str(fx_sqrt(fx(16))), "4", "sqrt 16")
test_str(fx_str(fx_sqrt(fx(2000000000))), "44721.359549", "sqrt large")
test_int(fx_sqrt(fx(-4)), 0, "sqrt negative")
test_str(fx_str(fx_pow(fx_parse("1.5", &ok), 3)), "3.375", "pow")
test_int(fx_int(fx_parse("-2.7", &ok)), -2, "int truncates")
test_int(fx_floor(fx_parse("-2.1", &ok)), -3, "floor")
test_int(fx_ceil(fx_parse("2.1", &ok)), 3, "ceil")
test_int(fx_round(fx_parse("2.5", &ok)), 3, "round half")
test_int(fx_round(fx_parse("-2.5", &ok)), -3, "round half negative")
test_int(fx_round(fx_parse("2.49", &ok)), 2, "round down")
test_str(fx_str(0), "0", "str 0")
test_str(fx_str(fx(-3)), "-3", "str whole")
test_str(fx_str(-5), "-0.000005", "str tiny")
test_str(fx_str_places(FX_PI, 2), "3.14", "places 2")
test_str(fx_str_places(fx_parse("2.5", &ok), 2), "2.50", "places pads")
test_str(fx_str_places(fx_parse("2.995", &ok), 2), "3.00", "places rounds up")
test_str(fx_str_places(fx_parse("-0.005", &ok), 2), "-0.01", "places rounds away from zero")
test_str(fx_str_places(FX_E, 0), "3", "places 0")
test_str(fx_str(fx_abs(fx(-2))), "2", "abs")
return test_done()
