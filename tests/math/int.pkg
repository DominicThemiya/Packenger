use std
use rt/test
use math/int

test_int(math_abs(-5), 5, "abs")
test_int(math_abs(MATH_MIN), MATH_MIN, "abs of min stays")
test_int(math_sign(-9), -1, "sign")
test_int(math_sign(0), 0, "sign 0")
test_int(math_min(3, -2), -2, "min")
test_int(math_max(3, -2), 3, "max")
test_int(math_clamp(15, 0, 10), 10, "clamp high")
test_int(math_clamp(-1, 0, 10), 0, "clamp low")
test_int(math_clamp(5, 0, 10), 5, "clamp inside")
test_int(math_gcd(84, 36), 12, "gcd")
test_int(math_gcd(-84, 36), 12, "gcd negative")
test_int(math_gcd(0, 7), 7, "gcd with 0")
test_int(math_lcm(4, 6), 12, "lcm")
test_int(math_lcm(0, 6), 0, "lcm 0")
test_int(math_pow(3, 4), 81, "pow")
test_int(math_pow(-2, 63), MATH_MIN, "pow to the edge")
test_int(math_pow(5, 0), 1, "pow 0")
test_int(math_pow(5, -1), 0, "pow negative")
test_int(math_pow_mod(2, 100, 1000000007), 976371285, "pow_mod")
test_int(math_pow_mod(-3, 3, 7), 1, "pow_mod negative base")
test_int(math_pow_mod(5, 3, 1), 0, "pow_mod 1")
test_int(math_mul_mod(MATH_MAX - 1, MATH_MAX - 2, MATH_MAX), 2, "mul_mod without overflow")
test_int(math_isqrt(99), 9, "isqrt 99")
test_int(math_isqrt(100), 10, "isqrt 100")
test_int(math_isqrt(0), 0, "isqrt 0")
test_int(math_isqrt(-4), 0, "isqrt negative")
test_int(math_isqrt(MATH_MAX), 3037000499, "isqrt max")
test_int(math_ilog2(1), 0, "ilog2 1")
test_int(math_ilog2(1023), 9, "ilog2 1023")
test_int(math_ilog2(0), -1, "ilog2 0")
test_int(math_ilog10(999), 2, "ilog10 999")
test_int(math_ilog10(1000), 3, "ilog10 1000")
test_int(math_digits(0), 1, "digits 0")
test_int(math_digits(-12345), 5, "digits negative")
test_int(math_digits(MATH_MIN), 19, "digits min")
test_true(math_is_prime(2), "prime 2")
test_true(math_is_prime(1000003), "prime 1000003")
test_true(math_is_prime(2147483647), "prime 2^31-1")
test_true(math_is_prime(9223372036854775783), "largest 64-bit prime")
test_true(!math_is_prime(1), "1 is not prime")
test_true(!math_is_prime(561), "Carmichael 561")
test_true(!math_is_prime(3215031751), "strong pseudoprime to 2, 3, 5, 7")
test_true(!math_is_prime(MATH_MAX), "max is not prime")
let primes = 0
for i = 1 to 1000
  if math_is_prime(i)
    primes = primes + 1
  end
end
test_int(primes, 168, "168 primes below 1000")
test_int(math_floor_div(-7, 2), -4, "floor_div")
test_int(math_floor_div(7, -2), -4, "floor_div negative divisor")
test_int(math_floor_div(6, 3), 2, "floor_div exact")
test_int(math_floor_mod(-7, 3), 2, "floor_mod")
test_int(math_floor_mod(7, -3), -2, "floor_mod negative divisor")
test_int(math_ceil_div(7, 2), 4, "ceil_div")
test_int(math_ceil_div(-7, 2), -3, "ceil_div negative")
test_int(math_div_round(7, 2), 4, "round half up")
test_int(math_div_round(-7, 2), -4, "round half away from zero")
test_int(math_div_round(5, 3), 2, "round 1.67")
test_int(math_div_round(4, 3), 1, "round 1.33")
test_int(math_factorial(20), 2432902008176640000, "20!")
test_int(math_factorial(21), 0, "21! doesn't fit")
test_int(math_binomial(10, 3), 120, "binomial")
test_int(math_binomial(62, 31), 465428353255261088, "binomial large")
test_int(math_binomial(5, 6), 0, "binomial out of range")
let ok = false
test_int(math_add_checked(MATH_MAX, 1, &ok), 0, "add overflow")
test_true(!ok, "add overflow flagged")
test_int(math_add_checked(MATH_MAX, -1, &ok), MATH_MAX - 1, "add fits")
test_true(ok, "add ok")
math_sub_checked(MATH_MIN, 1, &ok)
test_true(!ok, "sub overflow")
test_int(math_mul_checked(3037000499, 3037000499, &ok), 9223372030926249001, "mul fits")
test_true(ok, "mul ok")
math_mul_checked(1 << 40, 1 << 40, &ok)
test_true(!ok, "mul overflow")
math_mul_checked(-1, MATH_MIN, &ok)
test_true(!ok, "mul -1 by min")
test_int(math_ushr(-1, 63), 1, "ushr")
return test_done()
