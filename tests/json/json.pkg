use std
use rt/test
use json

let ok = false

// scalars
test_int(json_kind(json_parse("null", &ok)), JSON_NULL, "null")
test_true(ok, "null ok")
test_true(json_as_bool(json_parse(" true ", &ok)), "true with spaces")
test_true(!json_as_bool(json_parse("false", &ok)), "false")
test_int(json_as_int(json_parse("-42", &ok)), -42, "int")
test_true(json_is_int(json_parse("-42", &ok)), "is int")
test_int(json_as_int(json_parse("9223372036854775807", &ok)), 9223372036854775807, "max int")
test_int(json_as_int(json_parse("-9223372036854775808", &ok)), -9223372036854775807 - 1, "min int")
test_true(!json_is_int(json_parse("9223372036854775808", &ok)), "too big is not an int")
test_int(json_as_int(json_parse("9223372036854775808", &ok)), 0, "too big as int")
test_int(json_as_int(json_parse("2.9", &ok)), 2, "fraction truncates")
test_int(json_as_int(json_parse("-2.9", &ok)), -2, "negative fraction truncates")
test_int(json_as_int(json_parse("1e3", &ok)), 1000, "exponent")
test_int(json_as_int(json_parse("12.5E-1", &ok)), 1, "negative exponent")
test_int(json_as_int(json_parse("0.0001e4", &ok)), 1, "fraction and exponent")
test_true(!json_is_int(json_parse("1.0", &ok)), "1.0 is not an int")
let pi = json_parse("3.14159", &ok)
test_int(json_as_fixed(pi, 2, &ok), 314, "fixed 2")
test_true(ok, "fixed ok")
test_int(json_as_fixed(pi, 0, &ok), 3, "fixed 0")
test_int(json_as_fixed(json_parse("-1.5e2", &ok), 1, &ok), -1500, "fixed with exponent")
json_as_fixed(json_parse("1e30", &ok), 0, &ok)
test_true(!ok, "fixed overflow")
test_str(json_num_text(pi), "3.14159", "number text kept")
test_str(json_as_str(json_parse("\"a\\\"b\\\\c\\/d\\n\\t\"", &ok)), "a\"b\\c/d\n\t", "escapes")
test_str(json_as_str(json_parse("\"\\u00e9\\u4e2d\"", &ok)), "é中", "\\u to UTF-8")
test_str(json_as_str(json_parse("\"\\ud83d\\ude00\"", &ok)), "😀", "surrogate pair")
test_str(json_as_str(json_parse("\"\\ud83d!\"", &ok)), "\xef\xbf\xbd!", "lone surrogate")
test_str(json_as_str(json_parse("\"héllo\"", &ok)), "héllo", "UTF-8 kept")

// arrays and objects
let doc = json_parse("{\"user\": {\"name\": \"Ada\", \"langs\": [\"en\", \"fr\"], \"age\": 36, \"admin\": false}, \"empty\": [], \"none\": {}}", &ok)
test_true(ok, "object ok")
test_int(json_kind(doc), JSON_OBJ, "object kind")
test_int(json_len(doc), 3, "object keys")
test_str(json_key(doc, 0), "user", "first key")
test_str(json_key(doc, 2), "none", "last key")
test_str(json_key(doc, 3), "", "key out of range")
test_str(json_as_str(json_path(doc, "user.name")), "Ada", "path")
test_str(json_as_str(json_path(doc, "user.langs.1")), "fr", "path index")
test_str(json_as_str(json_path(doc, "user.langs[0]")), "en", "path brackets")
test_true(json_path(doc, "user.langs.2") == null, "path out of range")
test_true(json_path(doc, "user.nope.x") == null, "path missing")
test_true(json_path(doc, "user.langs.x") == null, "path bad index")
let user = json_get(doc, "user")
test_str(json_get_str(user, "name", "?"), "Ada", "get_str")
test_str(json_get_str(user, "age", "?"), "?", "get_str of a number")
test_int(json_get_int(user, "age", -1), 36, "get_int")
test_int(json_get_int(user, "missing", -1), -1, "get_int default")
test_true(!json_get_bool(user, "admin", true), "get_bool")
test_true(json_has(user, "admin"), "has")
test_true(!json_has(user, "x"), "has not")
test_int(json_len(json_get(doc, "empty")), 0, "empty array")
test_int(json_kind(json_get(doc, "none")), JSON_OBJ, "empty object")
test_int(json_len(json_get(json_get(json_get(doc, "a"), "b"), "c")), 0, "chained lookups of nothing")
test_str(json_kind_name(json_kind(json_get(user, "langs"))), "array", "kind name")
let dup = json_parse("{\"a\": 1, \"b\": 2, \"a\": 3}", &ok)
test_int(json_len(dup), 2, "duplicate key replaces")
test_int(json_get_int(dup, "a", 0), 3, "last value wins")
test_str(json_key(dup, 0), "a", "first position kept")

// writing
test_str(json_write(doc), "{\"user\":{\"name\":\"Ada\",\"langs\":[\"en\",\"fr\"],\"age\":36,\"admin\":false},\"empty\":[],\"none\":{}}", "write")
let o = json_obj()
json_set(o, "name", json_str("Ada \"Lovelace\"\n"))
json_set(o, "year", json_int(1843))
json_set(o, "pi", json_fixed(314, 2))
json_set(o, "tiny", json_fixed(-5, 3))
json_set(o, "list", json_arr())
json_push(json_get(o, "list"), json_null())
json_push(json_get(o, "list"), json_bool(true))
json_set(o, "ctl", json_str("\x01"))
test_str(json_write(o), "{\"name\":\"Ada \\\"Lovelace\\\"\\n\",\"year\":1843,\"pi\":3.14,\"tiny\":-0.005,\"list\":[null,true],\"ctl\":\"\\u0001\"}", "write built")
test_str(json_pretty(json_parse("{\"a\":[1,{}],\"b\":{\"c\":[]}}", &ok), 2), "{\n  \"a\": [\n    1,\n    {}\n  ],\n  \"b\": {\n    \"c\": []\n  }\n}", "pretty")
test_str(json_write(json_parse(json_write(o), &ok)), json_write(o), "round trip")
test_str(json_write(json_parse("[1.50, -0, 2E+3]", &ok)), "[1.50,-0,2E+3]", "numbers as written")
test_true(json_num("01") == null, "json_num rejects bad text")
test_str(json_quote("tab\there"), "\"tab\\there\"", "quote")

// errors
fn bad(text: str, want: str)
  let ok = true
  let j = json_parse(text, &ok)
  test_true(!ok && j == null, str_concat("rejects ", text))
  test_str(json_error(), want, str_concat("error for ", text))
end
bad("", "line 1, column 1: expected a value, found end of input")
bad("[1, 2", "line 1, column 6: expected ',' or ']' in an array, found end of input")
bad("[1,]", "line 1, column 4: expected a value, found ']'")
bad("{\"a\" 1}", "line 1, column 6: expected ':' after a key, found '1'")
bad("{a: 1}", "line 1, column 2: expected a string key, found 'a'")
bad("{\"a\": 1,\n \"b\": tru}", "line 2, column 7: expected a value, found 't'")
bad("01", "line 1, column 2: unexpected '1' after the value")
bad("-", "line 1, column 1: invalid number")
bad("1.", "line 1, column 1: invalid number")
bad("\"abc", "line 1, column 5: unterminated string")
bad("\"a\\qb\"", "line 1, column 3: invalid escape \\q")
bad("\"\\u12g4\"", "line 1, column 2: \\u needs four hex digits")
bad("\"a\nb\"", "line 1, column 3: control character in a string (escape it)")
bad("[1] [2]", "line 1, column 5: unexpected '[' after the value")
bad("nul", "line 1, column 1: expected a value, found 'n'")
bad("// no comments", "line 1, column 1: expected a value, found '/'")
let deep = ""
for i = 1 to 513
  deep = str_concat(deep, "[")
end
bad(deep, "line 1, column 513: nested more than 512 levels deep")
json_parse("[1]", &ok)
test_true(ok, "ok again after an error")
return test_done()
