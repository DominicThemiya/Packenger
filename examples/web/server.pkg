use std
use rt

// A package registry server: serves a folder of package files over HTTP,
// so programs can get packages from it instead of the universal registry.
//
//   packenger run examples/web/server.pkg -- examples/web/registry
//   packenger run examples/web/server.pkg -- registry 6464 0.0.0.0
//
// Arguments: the folder (default: registry), the port (default: 6464) and
// the address to listen on (default: 127.0.0.1, this machine only; 0.0.0.0
// to accept connections from other machines).
//
//   GET /std/if.pkg   the package file, which is what compilers fetch
//   GET /index.txt    every package name, one per line, for tools such as
//                     tools/treestat.pkg (a folder can't be listed over HTTP)
//   GET /             a page listing every package, with its summary
//
// A program routes packages here with a pkg_tree.pkg next to it (see
// app.pkg). Linux only: it talks to the kernel with system calls, so it runs
// with bintables and ctables. One request at a time, which is plenty for
// compilers fetching a few dozen small files.

const SYS_READ = 0
const SYS_CLOSE = 3
const SYS_SOCKET = 41
const SYS_ACCEPT = 43
const SYS_SENDTO = 44
const SYS_BIND = 49
const SYS_LISTEN = 50
const SYS_SETSOCKOPT = 54
const AF_INET = 2
const SOCK_STREAM = 1
const SOL_SOCKET = 1
const SO_REUSEADDR = 2
const SO_RCVTIMEO = 20
const SO_SNDTIMEO = 21
const MSG_NOSIGNAL = 16384

global root: str
global listen_at: str

// ---- small helpers ----

fn parse_num(s: str, max: int) -> int
  if len(s) == 0 || len(s) > 6
    return -1
  end
  let n = 0
  for i = 0 to len(s) - 1
    if s[i] < '0' || s[i] > '9'
      return -1
    end
    n = n * 10 + ((s[i] as int) - 48)
  end
  if n > max
    return -1
  end
  return n
end

// parse_ipv4 writes the four bytes of a dotted address like 127.0.0.1 to
// out[at], out[at + 1], ...
fn parse_ipv4(s: str, out: [u8], at: int) -> bool
  let parts = 0
  let start = 0
  for i = 0 to len(s)
    if i == len(s) || s[i] == '.'
      let n = parse_num(str_slice(s, start, i), 255)
      if n < 0 || parts == 4
        return false
      end
      out[at + parts] = n as u8
      parts = parts + 1
      start = i + 1
    end
  end
  return parts == 4
end

fn lower(s: str) -> str
  let b = sb_new()
  for i = 0 to len(s) - 1
    let c = s[i]
    if c >= 'A' && c <= 'Z'
      c = ((c as int) + 32) as u8
    end
    sb_byte(b, c)
  end
  return sb_str(b)
end

fn hex_digit(c: u8) -> int
  if c >= '0' && c <= '9'
    return (c as int) - 48
  elif c >= 'a' && c <= 'f'
    return (c as int) - 87
  elif c >= 'A' && c <= 'F'
    return (c as int) - 55
  end
  return -1
end

// url_decode turns %XX escapes back into bytes; compilers escape some of
// the symbols package names may contain.
fn url_decode(s: str) -> str
  let b = sb_new()
  let i = 0
  while i < len(s)
    if s[i] == '%' && i + 2 < len(s) && hex_digit(s[i + 1]) >= 0 && hex_digit(s[i + 2]) >= 0
      sb_byte(b, (hex_digit(s[i + 1]) * 16 + hex_digit(s[i + 2])) as u8)
      i = i + 3
    else
      sb_byte(b, s[i])
      i = i + 1
    end
  end
  return sb_str(b)
end

// safe_path accepts /a/b.pkg style paths: no empty, hidden, "." or ".."
// segments, and no NUL bytes, so nothing outside the folder is reachable.
fn safe_path(p: str) -> bool
  if len(p) < 2 || p[0] != '/'
    return false
  end
  let start = 1
  for i = 1 to len(p)
    if i == len(p) || p[i] == '/'
      if i == start || p[start] == '.'
        return false
      end
      start = i + 1
    elif p[i] == 0 as u8
      return false
    end
  end
  return true
end

fn html_escape(s: str) -> str
  let b = sb_new()
  for i = 0 to len(s) - 1
    let c = s[i]
    if c == '<'
      sb_add(b, "&lt;")
    elif c == '>'
      sb_add(b, "&gt;")
    elif c == '&'
      sb_add(b, "&amp;")
    elif c == '"'
      sb_add(b, "&quot;")
    else
      sb_byte(b, c)
    end
  end
  return sb_str(b)
end

// summary_html escapes a package summary and shows `code` as code.
fn summary_html(s: str) -> str
  let b = sb_new()
  let code = false
  for i = 0 to len(s) - 1
    if s[i] == '`'
      if code
        sb_add(b, "</code>")
      else
        sb_add(b, "<code>")
      end
      code = !code
    else
      sb_add(b, html_escape(str_slice(s, i, i + 1)))
    end
  end
  if code
    sb_add(b, "</code>")
  end
  return sb_str(b)
end

// ---- the folder ----

// package_names lists every package in the folder, like "std/if".
fn package_names() -> ptr Vec
  let names = vec_new()
  let files = fs_walk(root, false)
  for i = 0 to vec_len(files) - 1
    let f = vec_get(files, i) as str
    if path_ext(f) == ".pkg"
      vec_push(names, str_slice(f, 0, len(f) - 4) as int)
    end
  end
  return names
end

fn top_segment(name: str) -> str
  let slash = str_find_byte(name, '/', 0)
  if slash < 0
    return name
  end
  return str_slice(name, 0, slash)
end

// summary returns the text after "doc " on the file's doc line.
fn summary(text: str) -> str
  let at = 0
  if !str_starts(text, "doc ")
    at = str_find(text, "\ndoc ", 0)
    if at < 0
      return ""
    end
    at = at + 1
  end
  let stop = str_find_byte(text, '\n', at)
  if stop < 0
    stop = len(text)
  end
  return str_slice(text, at + 4, stop)
end

fn is_truck(text: str) -> bool
  return str_starts(text, "truck\n") || str_find(text, "\ntruck\n", 0) >= 0
end

// ---- HTTP ----

fn send_all(c: int, s: str) -> bool
  let done = 0
  while done < len(s)
    let n = syscall(SYS_SENDTO, c, mem_add(cstr(s), done), len(s) - done, MSG_NOSIGNAL, 0, 0)
    if n <= 0
      return false
    end
    done = done + n
  end
  return true
end

fn respond(c: int, status: str, kind: str, body: str, head: bool)
  let b = sb_new()
  sb_add(b, "HTTP/1.1 ")
  sb_add(b, status)
  sb_add(b, "\r\nContent-Type: ")
  sb_add(b, kind)
  sb_add(b, "\r\nContent-Length: ")
  sb_int(b, len(body))
  sb_add(b, "\r\nCache-Control: no-cache\r\nConnection: close\r\n\r\n")
  if send_all(c, sb_str(b)) && !head
    send_all(c, body)
  end
end

// read_request reads up to the end of the headers (or 16 KB).
fn read_request(c: int) -> str
  let buf = make([u8], 16384)
  let got = 0
  while got < len(buf)
    let n = syscall(SYS_READ, c, &buf[got], len(buf) - got)
    if n <= 0
      break
    end
    got = got + n
    let so_far = str_from(&buf[0], got)
    if str_find(so_far, "\r\n\r\n", 0) >= 0 || str_find(so_far, "\n\n", 0) >= 0
      break
    end
  end
  return str_from(&buf[0], got)
end

// header returns the value of the request header name (lower case), or "".
fn header(req: str, name: str) -> str
  let lines = str_find_byte(req, '\n', 0)
  while lines >= 0 && lines + 1 < len(req)
    let start = lines + 1
    let stop = str_find_byte(req, '\n', start)
    if stop < 0
      stop = len(req)
    end
    let line = str_slice(req, start, stop)
    let colon = str_find_byte(line, ':', 0)
    if colon > 0 && lower(str_slice(line, 0, colon)) == name
      let v = str_slice(line, colon + 1, len(line))
      while len(v) > 0 && (v[0] == ' ' || v[0] == '\t')
        v = str_slice(v, 1, len(v))
      end
      while len(v) > 0 && (v[len(v) - 1] == '\r' || v[len(v) - 1] == ' ')
        v = str_slice(v, 0, len(v) - 1)
      end
      return v
    end
    lines = str_find_byte(req, '\n', start)
  end
  return ""
end

// ---- the index ----

// index_text lists every package, like the index.txt that cmd/pkgdoc
// writes for the universal registry.
fn index_text() -> str
  let names = package_names()
  let b = sb_new()
  sb_add(b, "// Every package in this registry, one name per line, for tools that read\n")
  sb_add(b, "// it over HTTP (such as tools/treestat.pkg). Generated by server.pkg.\n")
  for i = 0 to vec_len(names) - 1
    sb_add(b, vec_get(names, i) as str)
    sb_byte(b, '\n')
  end
  return sb_str(b)
end

// ---- the index page ----

fn index_page(host: str) -> str
  let names = package_names()
  let tops = vec_new()
  for i = 0 to vec_len(names) - 1
    let top = top_segment(vec_get(names, i) as str)
    if vec_len(tops) == 0 || (vec_last(tops) as str) != top
      vec_push(tops, top as int)
    end
  end

  // the listing first, since the header shows the total size
  let list = sb_new()
  let total = 0
  let i = 0
  while i < vec_len(names)
    let top = top_segment(vec_get(names, i) as str)
    let rows = sb_new()
    let count = 0
    let truck = false
    while i < vec_len(names) && top_segment(vec_get(names, i) as str) == top
      let name = vec_get(names, i) as str
      let ok = false
      let text = io_read_file(path_join(root, str_concat(name, ".pkg")), &ok)
      if name == top
        truck = is_truck(text)
      end
      sb_add(rows, "<tr data-q=\"")
      sb_add(rows, html_escape(lower(str_concat(str_concat(name, " "), summary(text)))))
      sb_add(rows, "\"><td class=\"n\"><a href=\"/")
      sb_add(rows, html_escape(name))
      sb_add(rows, ".pkg\">")
      sb_add(rows, html_escape(name))
      sb_add(rows, "</a></td><td class=\"d\">")
      sb_add(rows, summary_html(summary(text)))
      sb_add(rows, "</td><td class=\"s\">")
      sb_add(rows, fmt_size(len(text)))
      sb_add(rows, "</td></tr>\n")
      count = count + 1
      total = total + len(text)
      i = i + 1
    end
    sb_add(list, "<section id=\"")
    sb_add(list, html_escape(top))
    sb_add(list, "\"><h2><span>")
    sb_add(list, html_escape(top))
    sb_add(list, "</span><span class=\"k\">")
    if truck
      sb_add(list, "truck")
    else
      sb_add(list, "package")
    end
    sb_add(list, "</span><span class=\"c\">")
    sb_int(list, count)
    sb_add(list, "</span></h2><table><thead><tr><th>Name</th><th>Description</th><th class=\"s\">Size</th></tr></thead><tbody>\n")
    sb_add(list, sb_str(rows))
    sb_add(list, "</tbody></table></section>\n")
  end
  if vec_len(names) == 0
    sb_add(list, "<p class=\"empty\">No .pkg files in this folder.</p>\n")
  end

  let b = sb_new()
  sb_add(b, "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">")
  sb_add(b, "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
  sb_add(b, "<title>Package registry</title><style>")
  sb_add(b, ":root{--bg:#e9e7df;--panel:#f3f2ec;--ink:#1c1c1a;--muted:#626057;--rule:#1c1c1a;--faint:#c9c6bb;--accent:#b8620f;--head:#1c1c1a;--headfg:#e9e7df;color-scheme:light dark}")
  sb_add(b, "@media (prefers-color-scheme:dark){:root{--bg:#141413;--panel:#1b1b19;--ink:#d6d3c6;--muted:#8d8a7f;--rule:#d6d3c6;--faint:#33322e;--accent:#e0943a;--head:#d6d3c6;--headfg:#141413}}")
  sb_add(b, "*{box-sizing:border-box}html{background:var(--bg)}body{margin:0;background:var(--bg);color:var(--ink);")
  sb_add(b, "font:13px/1.55 'IBM Plex Mono','JetBrains Mono',ui-monospace,'SF Mono',Menlo,Consolas,monospace}")
  sb_add(b, "main{max-width:1000px;margin:0 auto;padding:0 16px 48px}")
  sb_add(b, "header{display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;padding:22px 0 10px;border-bottom:3px double var(--rule)}")
  sb_add(b, "h1{margin:0;font-size:15px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}h1::before{content:'';display:inline-block;width:9px;height:9px;background:var(--accent);margin-right:10px}")
  sb_add(b, ".host{color:var(--muted)}")
  sb_add(b, "dl{display:grid;grid-template-columns:repeat(4,auto);margin:0;border-bottom:1px solid var(--rule)}")
  sb_add(b, "dl div{padding:8px 12px 8px 0;min-width:0}dl div+div{padding-left:12px;border-left:1px solid var(--faint)}")
  sb_add(b, "dt,th,.label{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:500}")
  sb_add(b, "dd{margin:0;overflow-wrap:anywhere}")
  sb_add(b, ".usage{margin:20px 0;border:1px solid var(--rule);background:var(--panel)}")
  sb_add(b, ".usage .label{display:block;padding:5px 10px;border-bottom:1px solid var(--rule)}")
  sb_add(b, ".usage p{margin:0;padding:8px 10px;color:var(--muted)}pre{margin:0 10px;padding:10px 12px;border:1px dashed var(--faint);overflow-x:auto;font:inherit}")
  sb_add(b, "code{font:inherit;color:var(--ink)}")
  sb_add(b, "nav{display:flex;flex-wrap:wrap;gap:4px 14px;align-items:center;margin:0 0 12px}nav a{color:var(--ink)}")
  sb_add(b, ".filter{display:flex;align-items:center;gap:10px;margin:0 0 20px}")
  sb_add(b, "input{flex:1;font:inherit;color:var(--ink);background:var(--panel);border:1px solid var(--rule);border-radius:0;padding:6px 8px;outline:none}input:focus{box-shadow:inset 0 0 0 1px var(--accent);border-color:var(--accent)}")
  sb_add(b, "section{margin:0 0 22px;scroll-margin-top:12px}")
  sb_add(b, "h2{display:flex;gap:16px;margin:0;padding:4px 10px;background:var(--head);color:var(--headfg);font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}")
  sb_add(b, "h2 .k,h2 .c{font-weight:400;opacity:.75}h2 .c{margin-left:auto}")
  sb_add(b, "table{width:100%;border-collapse:collapse;border:1px solid var(--rule);border-top:0;background:var(--panel)}")
  sb_add(b, "th{text-align:left;padding:5px 10px;border-bottom:1px solid var(--rule)}td{padding:5px 10px;border-top:1px solid var(--faint);vertical-align:top}tbody tr:first-child td{border-top:0}")
  sb_add(b, "tbody tr:hover{background:var(--bg)}td.n{white-space:nowrap;width:1%}.s{white-space:nowrap;width:1%;text-align:right;color:var(--muted)}")
  sb_add(b, "td.d{color:var(--muted)}td.d code{color:var(--ink)}")
  sb_add(b, "a{color:var(--ink);text-decoration:none;border-bottom:1px solid var(--faint)}a:hover{color:var(--accent);border-bottom-color:var(--accent)}")
  sb_add(b, ".empty{color:var(--muted)}footer{margin-top:28px;padding-top:8px;border-top:1px solid var(--rule);color:var(--muted);display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}")
  sb_add(b, "@media (max-width:640px){dl{grid-template-columns:repeat(2,auto)}dl div:nth-child(3){padding-left:0;border-left:0}.s{display:none}td.n{white-space:normal}}")
  sb_add(b, "</style></head><body><main>\n")

  sb_add(b, "<header><h1>Package registry</h1><span class=\"host\">")
  sb_add(b, html_escape(host))
  sb_add(b, "</span></header>\n<dl><div><dt>Packages</dt><dd>")
  sb_int(b, vec_len(names))
  sb_add(b, "</dd></div><div><dt>Groups</dt><dd>")
  sb_int(b, vec_len(tops))
  sb_add(b, "</dd></div><div><dt>Size</dt><dd>")
  sb_add(b, fmt_size(total))
  sb_add(b, "</dd></div><div><dt>Folder</dt><dd>")
  sb_add(b, html_escape(root))
  sb_add(b, "</dd></div></dl>\n")

  sb_add(b, "<div class=\"usage\"><span class=\"label\">Usage</span>")
  sb_add(b, "<p>Add these routes to <code>pkg_tree.pkg</code> next to your program, and <code>use pkg_tree</code> in it:</p><pre>tree\n")
  for k = 0 to vec_len(tops) - 1
    sb_add(b, "  ")
    sb_add(b, html_escape(str_pad(vec_get(tops, k) as str, 10)))
    sb_add(b, " http://")
    sb_add(b, html_escape(host))
    sb_add(b, "\n")
  end
  sb_add(b, "</pre><p>Unrouted packages come from the default registry. <code>*  http://")
  sb_add(b, html_escape(host))
  sb_add(b, "</code> routes everything here.</p></div>\n")

  if vec_len(tops) > 1
    sb_add(b, "<nav><span class=\"label\">Jump to</span>")
    for k = 0 to vec_len(tops) - 1
      let t = html_escape(vec_get(tops, k) as str)
      sb_add(b, "<a href=\"#")
      sb_add(b, t)
      sb_add(b, "\">")
      sb_add(b, t)
      sb_add(b, "</a>")
    end
    sb_add(b, "</nav>\n")
  end
  sb_add(b, "<div class=\"filter\"><label class=\"label\" for=\"q\">Filter</label><input id=\"q\" type=\"search\" autocomplete=\"off\" spellcheck=\"false\"></div>\n")
  sb_add(b, sb_str(list))
  sb_add(b, "<footer><span>GET /&lt;name&gt;.pkg returns a package's source; <a href=\"/index.txt\">/index.txt</a> lists them all.</span><span>")
  sb_add(b, html_escape(host))
  sb_add(b, "</span></footer>\n")
  sb_add(b, "<script>const q=document.getElementById('q');q.addEventListener('input',()=>{const t=q.value.trim().toLowerCase();")
  sb_add(b, "for(const s of document.querySelectorAll('section')){let n=0;for(const r of s.querySelectorAll('tbody tr')){const m=!t||r.dataset.q.includes(t);r.hidden=!m;if(m)n++}s.hidden=n===0}})</script>\n")
  sb_add(b, "</main></body></html>\n")
  return sb_str(b)
end

// ---- serving ----

fn serve(c: int)
  let req = read_request(c)
  let line_end = str_find_byte(req, '\n', 0)
  if line_end < 0
    line_end = len(req)
  end
  let line = str_slice(req, 0, line_end)
  let sp1 = str_find_byte(line, ' ', 0)
  let sp2 = -1
  if sp1 > 0
    sp2 = str_find_byte(line, ' ', sp1 + 1)
  end
  if sp2 < 0
    respond(c, "400 Bad Request", "text/plain; charset=utf-8", "bad request\n", false)
    return
  end
  let method = str_slice(line, 0, sp1)
  let target = str_slice(line, sp1 + 1, sp2)
  let q = str_find_byte(target, '?', 0)
  if q >= 0
    target = str_slice(target, 0, q)
  end
  let path = url_decode(target)
  let head = method == "HEAD"
  let status = "200 OK"
  let body = ""
  let kind = "text/plain; charset=utf-8"

  if method != "GET" && !head
    status = "405 Method Not Allowed"
    body = "only GET and HEAD\n"
  elif path == "/" || path == "/index.html"
    let host = header(req, "host")
    if host == "" || !safe_host(host)
      host = listen_at
    end
    body = index_page(host)
    kind = "text/html; charset=utf-8"
  elif path == "/index.txt"
    body = index_text()
  elif str_ends(path, ".pkg") && safe_path(path)
    let ok = false
    body = io_read_file(str_concat(root, path), &ok)
    if !ok
      status = "404 Not Found"
      body = str_concat(str_concat("no package at ", path), "\n")
    end
  else
    status = "404 Not Found"
    body = str_concat(str_concat("nothing at ", path), "\n")
  end
  respond(c, status, kind, body, head)
  io_outln(str_concat(str_concat(str_concat(str_concat(str_concat(method, " "), path), " "), str_slice(status, 0, 3)), str_concat(" ", fmt_size(len(body)))))
  io_flush()
end

// safe_host accepts what a Host header should look like: a name or address
// and a port, nothing that could break out of the page.
fn safe_host(h: str) -> bool
  for i = 0 to len(h) - 1
    let c = h[i]
    let ok = c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
    if !(ok || c == '.' || c == '-' || c == ':' || c == '[' || c == ']')
      return false
    end
  end
  return true
end

let args = argv
if len(args) > 4
  io_err("usage: server [folder] [port] [address]\n")
  return 2
end
root = "registry"
let port = 6464
let address = "127.0.0.1"
if len(args) > 1
  root = args[1]
end
while len(root) > 1 && root[len(root) - 1] == '/'
  root = str_slice(root, 0, len(root) - 1)
end
if len(args) > 2
  port = parse_num(args[2], 65535)
  if port < 1
    io_err(str_concat(str_concat("server: bad port ", args[2]), "\n"))
    return 2
  end
end
if len(args) > 3
  address = args[3]
end

if !fs_is_dir(root)
  io_err(str_concat(str_concat("server: ", root), " is not a folder\n"))
  return 1
end

// struct sockaddr_in: family, port (big-endian), address, padding
let addr = make([u8], 16)
addr[0] = AF_INET as u8
addr[2] = (port >> 8) as u8
addr[3] = (port & 255) as u8
if !parse_ipv4(address, addr, 4)
  io_err(str_concat(str_concat("server: bad address ", address), ", expected something like 127.0.0.1\n"))
  return 2
end
listen_at = str_concat(str_concat(address, ":"), str_from_int(port))

let sock = syscall(SYS_SOCKET, AF_INET, SOCK_STREAM, 0)
if sock < 0
  io_err("server: can't create a socket\n")
  return 1
end
let one = make([int], 1)
one[0] = 1
syscall(SYS_SETSOCKOPT, sock, SOL_SOCKET, SO_REUSEADDR, &one[0], 4)
if syscall(SYS_BIND, sock, &addr[0], 16) < 0
  io_err(str_concat(str_concat("server: can't listen on ", listen_at), " (is something else using the port?)\n"))
  return 1
end
syscall(SYS_LISTEN, sock, 128)
io_outln(str_concat(str_concat(str_concat(str_concat("serving ", root), " at http://"), listen_at), "/"))
io_flush()

// a client that stops talking is dropped after 5 seconds
let timeout = make([int], 2)
timeout[0] = 5
while true
  let c = syscall(SYS_ACCEPT, sock, 0, 0)
  if c >= 0
    syscall(SYS_SETSOCKOPT, c, SOL_SOCKET, SO_RCVTIMEO, &timeout[0], 16)
    syscall(SYS_SETSOCKOPT, c, SOL_SOCKET, SO_SNDTIMEO, &timeout[0], 16)
    serve(c)
    syscall(SYS_CLOSE, c)
  end
end
