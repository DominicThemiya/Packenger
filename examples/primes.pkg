use std

fn is_prime(n: int) -> bool
  if n < 2
    return false
  end
  let d = 2
  while d * d <= n
    if n % d == 0
      return false
    end
    d = d + 1
  end
  return true
end

let count = 0
for n = 1 to 100000
  if is_prime(n)
    count = count + 1
  end
end
print "primes below 100000:"
print count
