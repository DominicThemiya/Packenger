use std
use stdx
use rt/str

// match, from stdx: compares a value with each case's values in order and
// runs the first case that has an equal one, or else.
//
//   packenger run examples/roman.pkg
//   packenger run examples/roman.pkg -- MMXXVI XLII IIII

// value returns what one Roman digit is worth, or 0 if it isn't one.
fn value(c: u8) -> int
  match c
  case 'I', 'i'
    return 1
  case 'V', 'v'
    return 5
  case 'X', 'x'
    return 10
  case 'L', 'l'
    return 50
  case 'C', 'c'
    return 100
  case 'D', 'd'
    return 500
  case 'M', 'm'
    return 1000
  else
    return 0
  end
end

// roman reads a numeral: a digit before a larger one is subtracted (IV is
// 4), any other is added. It returns -1 if s isn't a numeral.
fn roman(s: str) -> int
  if len(s) == 0
    return -1
  end
  let total = 0
  for i = 0 to len(s) - 1
    let v = value(s[i])
    if v == 0
      return -1
    end
    if i + 1 < len(s) && v < value(s[i + 1])
      total -= v
    else
      total += v
    end
  end
  return total
end

// note adds a remark about some numerals, matching whole strings
fn note(s: str) -> str
  match s
  case "MMXXVI", "mmxxvi"
    return " (this year)"
  case "IIII"
    return " (as on clock faces)"
  end
  return ""
end

let numerals = argv
if len(numerals) <= 1
  // shaped like argv: the program name would be at 0
  numerals = make([str], 5)
  numerals[1] = "XIV"
  numerals[2] = "MCMXCIV"
  numerals[3] = "MMXXVI"
  numerals[4] = "XLIX"
end
for i = 1 to len(numerals) - 1
  let s = numerals[i]
  let n = roman(s)
  match n
  case -1
    print str_concat(s, " is not a Roman numeral")
  else
    print str_concat(str_concat(str_concat(s, " = "), str_from_int(n)), note(s))
  end
end
