use std
use stdx
use rt/vec

// counts things
struct Point
  x: int
  y: int
end
fn add(a: int, b: int) -> int
  return a + b  // the sum
end
fn neg(p: ptr Point) -> int
  return -p.x * -2
end
let xs = make([int], 3)
xs[0] = add(1, -2)
let total = 0
for i = 0 to len(xs) - 1
  if xs[i] < 0
    total += -xs[i]
  elif xs[i] == 0
    total += 1
  else
    print "a  //  b"
  end
end

let v = vec_new()
vec_push(v, total * 2)
while total > 0
  total -= 1
next
  print total
end
match total
case 0, 1
  print !true
else
  print 'x'
end
let p = new Point
p.x = 3
print neg(p)          // aligned
print total           // aligned too
