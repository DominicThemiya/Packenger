doc Slice allocation: `make([T], n)`: a 24-byte header and `n` zeroed elements.
  A negative length calls `$__pk_panic_len`.

emit
  (call $__pk_make
  {n}
  (i64.const {t.elemsize}))
  @alloc
support
  (func $__pk_make (param $n i64) (param $size i64) (result i64) (local $h i64)
    (if (i64.lt_s (local.get $n) (i64.const 0)) (then (call $__pk_panic_len)))
    (local.set $h (call $__pk_alloc (i64.const 24)))
    (i64.store (i32.wrap_i64 (local.get $h)) (call $__pk_alloc (i64.mul (local.get $n) (local.get $size))))
    (i64.store offset=8 (i32.wrap_i64 (local.get $h)) (local.get $n))
    (i64.store offset=16 (i32.wrap_i64 (local.get $h)) (local.get $n))
    (local.get $h))
