doc argv: `__pk_argv` builds a [str] from the arguments the kernel passed to the program.
  `_start` (in `bintables/program`) saves the initial stack pointer in
  `__pk_argp`; it points at `argc`, followed by `argc` pointers to C
  strings. On first use, `__pk_argv` copies each into a length-prefixed,
  zero-terminated string and builds the slice; later uses get the same
  slice.

emit
  call __pk_argv
  @alloc
support
  __pk_argv:
  mov rax, [rel __pk_argv_cache]
  test rax, rax
  jz .build
  ret
  .build:
  push rbx
  push r12
  push r13
  push r14
  push r15
  mov rbx, [rel __pk_argp]
  mov r12, [rbx]
  mov rdi, 24
  call __pk_alloc
  mov r13, rax
  mov rdi, r12
  shl rdi, 3
  call __pk_alloc
  mov [r13], rax
  mov [r13+8], r12
  mov [r13+16], r12
  xor r14d, r14d
  .arg:
  cmp r14, r12
  jae .done
  mov r15, [rbx+8+r14*8]
  xor ecx, ecx
  .len:
  cmp byte [r15+rcx], 0
  je .copy
  inc rcx
  jmp .len
  .copy:
  push rcx
  lea rdi, [rcx+9]
  call __pk_alloc
  pop rcx
  mov [rax], rcx
  lea rdi, [rax+8]
  mov rsi, r15
  rep movsb
  mov rdx, [r13]
  mov [rdx+r14*8], rax
  inc r14
  jmp .arg
  .done:
  mov rax, r13
  mov [rel __pk_argv_cache], rax
  pop r15
  pop r14
  pop r13
  pop r12
  pop rbx
  ret
  section .data
  __pk_argv_cache: dq 0
  section .text
