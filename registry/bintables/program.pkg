doc Program skeleton: entry point, top-level code, functions, support code and data.
  Rendered once per program. The compiler fills these placeholders:

  | placeholder | contents |
  |---|---|
  | `{main}` | the top-level statements |
  | `{frame}` | stack space for top-level variables |
  | `{functions}` | every `fn` |
  | `{support}` | `support` sections of the packages used |
  | `{data}` | `data` sections, e.g. string literals |

  `_start` saves the initial stack pointer in `__pk_argp` (for `argv`),
  calls the top-level code as a function (`__pk_entry`), then passes its
  result to the `exit` system call, so a top-level `return` sets the exit
  code. Globals are reserved in the data section by the compiler, as
  `pk_g_<name>: dq 0`.

emit
  bits 64
  default rel
  global _start
  section .text
  _start:
  mov [rel __pk_argp], rsp
  call __pk_entry
  mov rdi, rax
  mov rax, 60
  syscall
  __pk_entry:
  push rbp
  mov rbp, rsp
  sub rsp, {frame}
  {main}
  xor eax, eax
  leave
  ret
  {functions}
  {support}
  section .data
  __pk_argp: dq 0
  {data}
