doc print: write the value and a newline to stdout with the write syscall.
  Support routines are included once if `print` is used:

  - `__pk_print_int` converts `rax` to decimal in a stack buffer (handling
    the sign and the most negative value) and writes it with one syscall;
    `u8` values print as numbers through it too;
  - `__pk_print_str` writes a length-prefixed string, then the newline;
  - `__pk_print_bool` writes `true` or `false`.

  The variant is chosen from the value's type.

emit when value str
  {value}
  call __pk_print_str
emit when value bool
  {value}
  call __pk_print_bool
emit
  {value}
  call __pk_print_int
support
  __pk_print_int:
  sub rsp, 40
  lea rsi, [rsp+32]
  mov byte [rsi], 10
  mov r8, rax
  mov rcx, rax
  neg rcx
  cmovl rcx, rax
  mov rax, rcx
  mov r9, 10
  .digit:
  xor edx, edx
  div r9
  add dl, 48
  dec rsi
  mov [rsi], dl
  test rax, rax
  jnz .digit
  test r8, r8
  jns .write
  dec rsi
  mov byte [rsi], 45
  .write:
  lea rdx, [rsp+33]
  sub rdx, rsi
  mov eax, 1
  mov edi, 1
  syscall
  add rsp, 40
  ret
  __pk_print_str:
  mov rdx, [rax]
  lea rsi, [rax+8]
  mov eax, 1
  mov edi, 1
  syscall
  push 10
  mov eax, 1
  mov edi, 1
  mov rsi, rsp
  mov edx, 1
  syscall
  add rsp, 8
  ret
  __pk_print_bool:
  lea rsi, [rel __pk_true]
  mov edx, 5
  test rax, rax
  jnz .write
  lea rsi, [rel __pk_false]
  mov edx, 6
  .write:
  mov eax, 1
  mov edi, 1
  syscall
  ret
  section .data
  __pk_true: db "true", 10
  __pk_false: db "false", 10
  section .text
