doc Comparison. The jfalse section lets if/while branch on the flags directly.
emit when right simple
  {left}
  cmp rax, {right.operand}
  setne al
  movzx eax, al
emit
  @binop
  cmp rax, rbx
  setne al
  movzx eax, al
emit jfalse when right simple
  {left}
  cmp rax, {right.operand}
  je {target}
emit jfalse
  @binop
  cmp rax, rbx
  je {target}
