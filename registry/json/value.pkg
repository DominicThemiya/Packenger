doc JSON values: the Json tree, making values, and reading them.
  A value is a `ptr Json` with a kind: `JSON_NULL`, `JSON_BOOL`,
  `JSON_NUM`, `JSON_STR`, `JSON_ARR` or `JSON_OBJ`. Objects keep their keys
  in the order they were first set; setting a key again replaces its value.

  ```
  let user = json_obj()
  json_set(user, "name", json_str("Ada"))
  json_set(user, "langs", json_arr())
  json_push(json_get(user, "langs"), json_str("en"))
  print json_get_str(user, "name", "?")       // Ada
  print json_len(json_get(user, "langs"))     // 1
  ```

  **Making values**

  | function | gives |
  |---|---|
  | `json_null()`, `json_bool(b)`, `json_int(n)`, `json_str(s)` | a new value |
  | `json_num(text: str) -> ptr Json` | a number from its JSON text (`"3.25"`, `"1e9"`), for numbers that aren't `int`s; `null` if `text` isn't a JSON number |
  | `json_fixed(n: int, places: int) -> ptr Json` | the number `n / 10^places`: `json_fixed(314, 2)` is `3.14` |
  | `json_arr()`, `json_obj()` | an empty array or object |
  | `json_push(a, v)` | append `v` to array `a` |
  | `json_set(o, key, v)` | set `o[key]` |

  **Reading values**: every function takes `null` or a value of the wrong
  kind, and gives the "nothing" answer, so lookups can be chained.

  | function | gives |
  |---|---|
  | `json_kind(j) -> int` | its kind; `JSON_NULL` for `null` too |
  | `json_kind_name(k: int) -> str` | `"null"`, `"bool"`, `"number"`, `"string"`, `"array"` or `"object"` |
  | `json_len(j) -> int` | items of an array, keys of an object, bytes of a string, else 0 |
  | `json_at(a, i) -> ptr Json` | item `i` of an array, or `null` |
  | `json_get(o, key) -> ptr Json`, `json_has(o, key) -> bool` | an object's value for `key`, or `null` |
  | `json_key(o, i) -> str`, `json_value(o, i) -> ptr Json` | an object's `i`-th key and value, in order |
  | `json_path(j, path) -> ptr Json` | follow `a.b.0.c` or `a.b[0].c`: names are keys, numbers index arrays |
  | `json_as_bool(j)`, `json_as_str(j)` | the value, or `false` / `""` |
  | `json_as_int(j) -> int` | a number truncated toward zero (`2.9` gives 2, `1e3` gives 1000), or 0 if not a number or too big |
  | `json_as_fixed(j, places, ok) -> int` | a number times `10^places`, truncated: `3.14159` with 2 gives 314; `*ok` is false if it isn't a number or doesn't fit |
  | `json_is_int(j) -> bool` | a number written as a plain integer that fits in an `int` |
  | `json_num_text(j) -> str` | a number as written in the source |
  | `json_get_str(o, key, def)`, `json_get_int(o, key, def)`, `json_get_bool(o, key, def)` | an object's value of that kind, or `def` if missing or of another kind |

needs std rt/str rt/vec rt/map
code
  const JSON_NULL = 0
  const JSON_BOOL = 1
  const JSON_NUM = 2
  const JSON_STR = 3
  const JSON_ARR = 4
  const JSON_OBJ = 5

  struct Json
    kind: int
    b: bool
    n: int
    num: str
    s: str
    items: ptr Vec
    obj: ptr Map
  end

  fn json_null() -> ptr Json
    return new Json
  end

  fn json_bool(b: bool) -> ptr Json
    let j = new Json
    j.kind = JSON_BOOL
    j.b = b
    return j
  end

  fn json_int(n: int) -> ptr Json
    let j = new Json
    j.kind = JSON_NUM
    j.n = n
    j.num = str_from_int(n)
    return j
  end

  fn json_num(text: str) -> ptr Json
    if json_num_end(text, 0) != len(text) || len(text) == 0
      return null
    end
    let j = new Json
    j.kind = JSON_NUM
    j.num = text
    let ok = false
    j.n = json_scaled(text, 0, &ok)
    return j
  end

  fn json_fixed(n: int, places: int) -> ptr Json
    if places <= 0
      return json_int(n)
    end
    let b = sb_new()
    let digits = str_from_int(n)
    let neg = false
    if n < 0
      neg = true
      digits = str_slice(digits, 1, len(digits))
    end
    while len(digits) <= places
      digits = str_concat("0", digits)
    end
    let whole = str_slice(digits, 0, len(digits) - places)
    let frac = str_rtrim(str_slice(digits, len(digits) - places, len(digits)), '0')
    if neg
      sb_byte(b, '-')
    end
    sb_add(b, whole)
    if frac != ""
      sb_byte(b, '.')
      sb_add(b, frac)
    end
    return json_num(sb_str(b))
  end

  fn json_str(s: str) -> ptr Json
    let j = new Json
    j.kind = JSON_STR
    j.s = s
    return j
  end

  fn json_arr() -> ptr Json
    let j = new Json
    j.kind = JSON_ARR
    j.items = vec_new()
    return j
  end

  fn json_obj() -> ptr Json
    let j = new Json
    j.kind = JSON_OBJ
    j.obj = map_new()
    return j
  end

  fn json_push(a: ptr Json, v: ptr Json)
    if a != null && a.kind == JSON_ARR
      vec_push(a.items, v as int)
    end
  end

  fn json_set(o: ptr Json, key: str, v: ptr Json)
    if o != null && o.kind == JSON_OBJ
      map_set(o.obj, key, v as int)
    end
  end

  fn json_kind(j: ptr Json) -> int
    if j == null
      return JSON_NULL
    end
    return j.kind
  end

  fn json_kind_name(k: int) -> str
    if k == JSON_BOOL
      return "bool"
    elif k == JSON_NUM
      return "number"
    elif k == JSON_STR
      return "string"
    elif k == JSON_ARR
      return "array"
    elif k == JSON_OBJ
      return "object"
    end
    return "null"
  end

  fn json_len(j: ptr Json) -> int
    let k = json_kind(j)
    if k == JSON_ARR
      return vec_len(j.items)
    elif k == JSON_OBJ
      return map_len(j.obj)
    elif k == JSON_STR
      return len(j.s)
    end
    return 0
  end

  fn json_at(a: ptr Json, i: int) -> ptr Json
    if json_kind(a) != JSON_ARR || i < 0 || i >= vec_len(a.items)
      return null
    end
    return vec_get(a.items, i) as ptr Json
  end

  fn json_get(o: ptr Json, key: str) -> ptr Json
    if json_kind(o) != JSON_OBJ
      return null
    end
    return map_get(o.obj, key) as ptr Json
  end

  fn json_has(o: ptr Json, key: str) -> bool
    return json_kind(o) == JSON_OBJ && map_has(o.obj, key)
  end

  fn json_key(o: ptr Json, i: int) -> str
    if json_kind(o) != JSON_OBJ || i < 0 || i >= map_len(o.obj)
      return ""
    end
    return map_key(o.obj, i)
  end

  fn json_value(o: ptr Json, i: int) -> ptr Json
    if json_kind(o) != JSON_OBJ || i < 0 || i >= map_len(o.obj)
      return null
    end
    return map_value(o.obj, i) as ptr Json
  end

  fn json_path(j: ptr Json, path: str) -> ptr Json
    let p = str_replace(str_replace(path, "[", "."), "]", "")
    let cur = j
    let parts = str_split(p, '.')
    for i = 0 to vec_len(parts) - 1
      let part = vec_get_str(parts, i)
      if part == ""
        continue
      end
      if json_kind(cur) == JSON_ARR
        let ok = false
        let k = str_parse_int(part, &ok)
        if !ok
          return null
        end
        cur = json_at(cur, k)
      else
        cur = json_get(cur, part)
      end
      if cur == null
        return null
      end
    end
    return cur
  end

  fn json_as_bool(j: ptr Json) -> bool
    return json_kind(j) == JSON_BOOL && j.b
  end

  fn json_as_str(j: ptr Json) -> str
    if json_kind(j) != JSON_STR
      return ""
    end
    return j.s
  end

  fn json_as_int(j: ptr Json) -> int
    if json_kind(j) != JSON_NUM
      return 0
    end
    return j.n
  end

  fn json_as_fixed(j: ptr Json, places: int, ok: ptr bool) -> int
    if json_kind(j) != JSON_NUM
      *ok = false
      return 0
    end
    return json_scaled(j.num, places, ok)
  end

  fn json_is_int(j: ptr Json) -> bool
    if json_kind(j) != JSON_NUM
      return false
    end
    for i = 0 to len(j.num) - 1
      let c = j.num[i]
      if c == '.' || c == 'e' || c == 'E'
        return false
      end
    end
    let ok = false
    str_parse_int(j.num, &ok)
    return ok
  end

  fn json_num_text(j: ptr Json) -> str
    if json_kind(j) != JSON_NUM
      return ""
    end
    return j.num
  end

  fn json_get_str(o: ptr Json, key: str, def: str) -> str
    let v = json_get(o, key)
    if json_kind(v) != JSON_STR
      return def
    end
    return v.s
  end

  fn json_get_int(o: ptr Json, key: str, def: int) -> int
    let v = json_get(o, key)
    if json_kind(v) != JSON_NUM
      return def
    end
    return v.n
  end

  fn json_get_bool(o: ptr Json, key: str, def: bool) -> bool
    let v = json_get(o, key)
    if json_kind(v) != JSON_BOOL
      return def
    end
    return v.b
  end

  // json_num_end: where a JSON number starting at i ends, or i if there
  // is none: -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?
  fn json_num_end(s: str, from: int) -> int
    let i = from
    if i < len(s) && s[i] == '-'
      i = i + 1
    end
    if i >= len(s) || s[i] < '0' || s[i] > '9'
      return from
    end
    if s[i] == '0'
      i = i + 1
    else
      while i < len(s) && s[i] >= '0' && s[i] <= '9'
        i = i + 1
      end
    end
    if i < len(s) && s[i] == '.'
      let d = i + 1
      while d < len(s) && s[d] >= '0' && s[d] <= '9'
        d = d + 1
      end
      if d == i + 1
        return from
      end
      i = d
    end
    if i < len(s) && (s[i] == 'e' || s[i] == 'E')
      let e = i + 1
      if e < len(s) && (s[e] == '+' || s[e] == '-')
        e = e + 1
      end
      let d = e
      while d < len(s) && s[d] >= '0' && s[d] <= '9'
        d = d + 1
      end
      if d == e
        return from
      end
      i = d
    end
    return i
  end

  // json_scaled: the number in text (a valid JSON number) times
  // 10^places, truncated toward zero; *ok false if it doesn't fit.
  fn json_scaled(text: str, places: int, ok: ptr bool) -> int
    *ok = false
    let i = 0
    let neg = false
    if len(text) > 0 && text[0] == '-'
      neg = true
      i = 1
    end
    let digits = sb_new()
    let exp = places
    let frac = false
    while i < len(text) && text[i] != 'e' && text[i] != 'E'
      if text[i] == '.'
        frac = true
      else
        sb_byte(digits, text[i])
        if frac
          exp = exp - 1
        end
      end
      i = i + 1
    end
    if i < len(text)
      let e = 0
      let eneg = false
      i = i + 1
      if text[i] == '+' || text[i] == '-'
        eneg = text[i] == '-'
        i = i + 1
      end
      while i < len(text)
        if e < 100000
          e = e * 10 + (text[i] as int - 48)
        end
        i = i + 1
      end
      if eneg
        exp = exp - e
      else
        exp = exp + e
      end
    end
    let ds = sb_str(digits)
    let keep = len(ds)
    if exp < 0
      keep = len(ds) + exp
    end
    // accumulate negatively, so the most negative int fits
    let n = 0
    let min = -9223372036854775807 - 1
    for k = 0 to keep - 1
      let d = ds[k] as int - 48
      if n < (min + d) / 10
        return 0
      end
      n = n * 10 - d
    end
    if exp > 0
      for k = 1 to exp
        if n != 0 && n < min / 10
          return 0
        end
        n = n * 10
      end
    end
    if !neg
      if n == min
        return 0
      end
      n = 0 - n
    end
    *ok = true
    return n
  end
