doc Reading JSON: json_parse(text, &ok) gives the tree, or an error with its line and column.
  ```
  let ok = false
  let doc = json_parse("{\"name\": \"Ada\", \"tags\": [\"math\", 1843]}", &ok)
  if !ok
    print json_error()      // e.g. line 1, column 9: expected ':' after a key, found '"'
  end
  print json_as_int(json_path(doc, "tags.1"))   // 1843
  ```

  | function | does |
  |---|---|
  | `json_parse(text: str, ok: ptr bool) -> ptr Json` | the value in `text`; on an error `*ok` is false and the result is `null` |
  | `json_error() -> str` | what the last failed `json_parse` found, with its line and column |

  It accepts exactly JSON (RFC 8259): no comments or trailing commas.
  Strings are decoded: escapes, including `\uXXXX` and surrogate pairs,
  become UTF-8 (a lone surrogate becomes U+FFFD). Numbers keep their text,
  so nothing is lost writing them back. Nesting is limited to 512 levels.
  Whitespace may surround the value; anything else after it is an error.

needs std rt/str rt/vec rt/map json/value
code
  global json_err: str = ""

  struct JsonP
    s: str
    i: int
    depth: int
    failed: bool
  end

  fn json_error() -> str
    return json_err
  end

  fn json_parse(text: str, ok: ptr bool) -> ptr Json
    let p = new JsonP
    p.s = text
    json_err = ""
    json_ws(p)
    let v = json_value_at(p)
    if !p.failed
      json_ws(p)
      if p.i < len(p.s)
        json_fail(p, str_concat3("unexpected ", json_what(p), " after the value"))
      end
    end
    *ok = !p.failed
    if p.failed
      return null
    end
    return v
  end

  // json_fail records the first error, at the current position.
  fn json_fail(p: ptr JsonP, msg: str)
    if p.failed
      return
    end
    p.failed = true
    let line = 1
    let col = 1
    let i = 0
    while i < p.i && i < len(p.s)
      if p.s[i] == '\n'
        line = line + 1
        col = 1
      elif (p.s[i] as int) & 192 != 128
        col = col + 1
      end
      i = i + 1
    end
    json_err = str_concat4("line ", str_from_int(line), ", column ", str_concat3(str_from_int(col), ": ", msg))
  end

  // json_what describes the byte at the current position, for messages.
  fn json_what(p: ptr JsonP) -> str
    if p.i >= len(p.s)
      return "end of input"
    end
    let c = p.s[p.i]
    if c < ' ' || c >= 127 as u8
      return str_concat("byte ", str_from_int(c as int))
    end
    let b = sb_new()
    sb_byte(b, '\'')
    sb_byte(b, c)
    sb_byte(b, '\'')
    return sb_str(b)
  end

  fn json_ws(p: ptr JsonP)
    while p.i < len(p.s)
      let c = p.s[p.i]
      if c != ' ' && c != '\t' && c != '\n' && c != '\r'
        return
      end
      p.i = p.i + 1
    end
  end

  fn json_word(p: ptr JsonP, w: str) -> bool
    if str_starts(str_slice(p.s, p.i, p.i + len(w)), w) && p.i + len(w) <= len(p.s)
      p.i = p.i + len(w)
      return true
    end
    return false
  end

  fn json_value_at(p: ptr JsonP) -> ptr Json
    if p.i >= len(p.s)
      json_fail(p, "expected a value, found end of input")
      return null
    end
    let c = p.s[p.i]
    if c == '{'
      return json_object_at(p)
    elif c == '['
      return json_array_at(p)
    elif c == '"'
      let s = json_string_at(p)
      if p.failed
        return null
      end
      return json_str(s)
    elif c == '-' || c >= '0' && c <= '9'
      let e = json_num_end(p.s, p.i)
      if e == p.i
        json_fail(p, "invalid number")
        return null
      end
      let j = json_num(str_slice(p.s, p.i, e))
      p.i = e
      return j
    elif json_word(p, "true")
      return json_bool(true)
    elif json_word(p, "false")
      return json_bool(false)
    elif json_word(p, "null")
      return json_null()
    end
    json_fail(p, str_concat("expected a value, found ", json_what(p)))
    return null
  end

  fn json_enter(p: ptr JsonP) -> bool
    p.depth = p.depth + 1
    if p.depth > 512
      json_fail(p, "nested more than 512 levels deep")
      return false
    end
    return true
  end

  fn json_array_at(p: ptr JsonP) -> ptr Json
    if !json_enter(p)
      return null
    end
    let a = json_arr()
    p.i = p.i + 1
    json_ws(p)
    if p.i < len(p.s) && p.s[p.i] == ']'
      p.i = p.i + 1
      p.depth = p.depth - 1
      return a
    end
    while true
      json_ws(p)
      let v = json_value_at(p)
      if p.failed
        return null
      end
      json_push(a, v)
      json_ws(p)
      if p.i < len(p.s) && p.s[p.i] == ','
        p.i = p.i + 1
      elif p.i < len(p.s) && p.s[p.i] == ']'
        p.i = p.i + 1
        p.depth = p.depth - 1
        return a
      else
        json_fail(p, str_concat("expected ',' or ']' in an array, found ", json_what(p)))
        return null
      end
    end
    return a
  end

  fn json_object_at(p: ptr JsonP) -> ptr Json
    if !json_enter(p)
      return null
    end
    let o = json_obj()
    p.i = p.i + 1
    json_ws(p)
    if p.i < len(p.s) && p.s[p.i] == '}'
      p.i = p.i + 1
      p.depth = p.depth - 1
      return o
    end
    while true
      json_ws(p)
      if p.i >= len(p.s) || p.s[p.i] != '"'
        json_fail(p, str_concat("expected a string key, found ", json_what(p)))
        return null
      end
      let k = json_string_at(p)
      if p.failed
        return null
      end
      json_ws(p)
      if p.i >= len(p.s) || p.s[p.i] != ':'
        json_fail(p, str_concat("expected ':' after a key, found ", json_what(p)))
        return null
      end
      p.i = p.i + 1
      json_ws(p)
      let v = json_value_at(p)
      if p.failed
        return null
      end
      json_set(o, k, v)
      json_ws(p)
      if p.i < len(p.s) && p.s[p.i] == ','
        p.i = p.i + 1
      elif p.i < len(p.s) && p.s[p.i] == '}'
        p.i = p.i + 1
        p.depth = p.depth - 1
        return o
      else
        json_fail(p, str_concat("expected ',' or '}' in an object, found ", json_what(p)))
        return null
      end
    end
    return o
  end

  fn json_hex4(p: ptr JsonP, at: int) -> int
    if at + 4 > len(p.s)
      return -1
    end
    let n = 0
    for k = at to at + 3
      let c = p.s[k]
      let d = -1
      if c >= '0' && c <= '9'
        d = c as int - 48
      elif c >= 'a' && c <= 'f'
        d = c as int - 87
      elif c >= 'A' && c <= 'F'
        d = c as int - 55
      end
      if d < 0
        return -1
      end
      n = n * 16 + d
    end
    return n
  end

  fn json_utf8(b: ptr StrBuf, r: int)
    if r < 128
      sb_byte(b, r as u8)
    elif r < 2048
      sb_byte(b, (192 | (r >> 6)) as u8)
      sb_byte(b, (128 | (r & 63)) as u8)
    elif r < 65536
      sb_byte(b, (224 | (r >> 12)) as u8)
      sb_byte(b, (128 | ((r >> 6) & 63)) as u8)
      sb_byte(b, (128 | (r & 63)) as u8)
    else
      sb_byte(b, (240 | (r >> 18)) as u8)
      sb_byte(b, (128 | ((r >> 12) & 63)) as u8)
      sb_byte(b, (128 | ((r >> 6) & 63)) as u8)
      sb_byte(b, (128 | (r & 63)) as u8)
    end
  end

  // json_string_at reads the string starting at the '"' at p.i.
  fn json_string_at(p: ptr JsonP) -> str
    let b = sb_new()
    p.i = p.i + 1
    while true
      if p.i >= len(p.s)
        json_fail(p, "unterminated string")
        return ""
      end
      let c = p.s[p.i]
      if c == '"'
        p.i = p.i + 1
        return sb_str(b)
      end
      if c < ' '
        json_fail(p, "control character in a string (escape it)")
        return ""
      end
      if c != '\\'
        sb_byte(b, c)
        p.i = p.i + 1
        continue
      end
      p.i = p.i + 1
      if p.i >= len(p.s)
        json_fail(p, "unterminated string")
        return ""
      end
      let e = p.s[p.i]
      p.i = p.i + 1
      if e == '"' || e == '\\' || e == '/'
        sb_byte(b, e)
      elif e == 'n'
        sb_byte(b, '\n')
      elif e == 't'
        sb_byte(b, '\t')
      elif e == 'r'
        sb_byte(b, '\r')
      elif e == 'b'
        sb_byte(b, 8 as u8)
      elif e == 'f'
        sb_byte(b, 12 as u8)
      elif e == 'u'
        let r = json_hex4(p, p.i)
        if r < 0
          p.i = p.i - 2
          json_fail(p, "\\u needs four hex digits")
          return ""
        end
        p.i = p.i + 4
        if r >= 55296 && r < 56320
          // a high surrogate: a low one should follow
          let lo = -1
          if p.i + 1 < len(p.s) && p.s[p.i] == '\\' && p.s[p.i + 1] == 'u'
            lo = json_hex4(p, p.i + 2)
          end
          if lo >= 56320 && lo < 57344
            r = 65536 + ((r - 55296) << 10) + (lo - 56320)
            p.i = p.i + 6
          else
            r = 65533
          end
        elif r >= 56320 && r < 57344
          r = 65533
        end
        json_utf8(b, r)
      else
        p.i = p.i - 2
        json_fail(p, str_concat("invalid escape \\", json_byte_str(e)))
        return ""
      end
    end
    return ""
  end

  fn json_byte_str(c: u8) -> str
    let b = sb_new()
    sb_byte(b, c)
    return sb_str(b)
  end
