doc pkc: downloading packages from the registry (port of internal/registry).
  `fe_url(base, name)` builds a package's URL like the Go compiler, with
  path segments escaped like Go's `url.PathEscape`. `fe_fetch` reads a
  `file://` registry directly and downloads `http(s)://` packages with
  `curl`. `fe_fetch_batch` fetches a whole round at once: one
  `curl --parallel` for every `http(s)://` package, like the Go compiler's
  parallel downloads. If that fails, each package is fetched again on its
  own, so errors carry the same messages as the Go compiler.

needs std rt pkc/util
code
  fn fe_name_char(c: u8, first: bool) -> bool
    if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c == '_'
      return true
    end
    if c >= '0' && c <= '9'
      return !first
    end
    return c == '-' || c == '\'' || c == '?' || c == '!' || c == '+' || c == '*' || c == '<' || c == '>' || c == '=' || c == '&' || c == '|' || c == '~' || c == '^'
  end

  // fe_valid_name: segments of name characters separated by '/'; a segment
  // doesn't start with a digit.
  fn fe_valid_name(name: str) -> bool
    let first = true
    for i = 0 to len(name) - 1
      let c = name[i]
      if c == '/'
        if first
          return false
        end
        first = true
      elif !fe_name_char(c, first)
        return false
      else
        first = false
      end
    end
    return !first
  end

  // fe_escape escapes one path segment like Go's url.PathEscape.
  fn fe_escape(seg: str) -> str
    let b = sb_new()
    for i = 0 to len(seg) - 1
      let c = seg[i]
      let keep = c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9'
      keep = keep || c == '-' || c == '_' || c == '.' || c == '~' || c == '$' || c == '&' || c == '+' || c == '=' || c == ':' || c == '@'
      if keep
        sb_byte(b, c)
      else
        sb_byte(b, '%')
        let digits = "0123456789ABCDEF"
        sb_byte(b, digits[((c as int) >> 4) & 15])
        sb_byte(b, digits[(c as int) & 15])
      end
    end
    return sb_str(b)
  end

  fn fe_unescape(s: str) -> str
    let b = sb_new()
    let i = 0
    while i < len(s)
      if s[i] == '%' && i + 2 < len(s)
        let ok = true
        let v = fe_hexval(s[i + 1]) * 16 + fe_hexval(s[i + 2])
        if fe_hexval(s[i + 1]) >= 0 && fe_hexval(s[i + 2]) >= 0
          sb_byte(b, v as u8)
          i = i + 3
          continue
        end
      end
      sb_byte(b, s[i])
      i = i + 1
    end
    return sb_str(b)
  end

  fn fe_hexval(c: u8) -> int
    if c >= '0' && c <= '9'
      return (c as int) - 48
    elif c >= 'a' && c <= 'f'
      return (c as int) - 87
    elif c >= 'A' && c <= 'F'
      return (c as int) - 55
    end
    return -1
  end

  fn fe_url(base: str, name: str) -> str
    let segs = u_split(name, '/')
    let esc = vec_new()
    for i = 0 to vec_len(segs) - 1
      u_push(esc, fe_escape(u_get(segs, i)))
    end
    return u_cat4(u_rtrim_byte(base, '/'), "/", u_join(esc, "/"), ".pkg")
  end

  // fe_fetch returns the source of package name; *origin is its URL. On an
  // error it sets pk_err and *ok to false.
  fn fe_fetch(base: str, name: str, origin: ptr str, ok: ptr bool) -> str
    *ok = false
    if !fe_valid_name(name)
      u_fail(u_cat("invalid package name ", u_quote(name)))
      return ""
    end
    let u = fe_url(base, name)
    *origin = u
    if str_starts(u, "file://")
      let path = fe_unescape(str_slice(u, 7, len(u)))
      if !io_exists(path)
        u_fail(u_cat4("package ", u_quote(name), " not found in registry (", u_cat(u, ")")))
        return ""
      end
      let read = false
      let src = io_read_file(path, &read)
      if !read
        u_fail(u_cat4("can't read package ", u_quote(name), " (", u_cat(u, ")")))
        return ""
      end
      *ok = true
      return src
    end
    return fe_curl(name, u, ok)
  end

  global fe_tmp_count: int = 0

  fn fe_tmp() -> str
    fe_tmp_count = fe_tmp_count + 1
    return u_cat4("/tmp/pkc-", str_from_int(syscall(39)), "-", str_from_int(fe_tmp_count))
  end

  fn fe_curl_args() -> ptr Vec
    let args = vec_new()
    u_push(args, "--silent")
    u_push(args, "--fail")
    u_push(args, "--location")
    u_push(args, "--user-agent")
    u_push(args, "packenger")
    u_push(args, "--max-time")
    u_push(args, "30")
    return args
  end

  // fe_fetch_batch fetches every package in names. For each, it pushes the
  // source to srcs, the URL to origins and the error ("" if none) to errs.
  fn fe_fetch_batch(base: str, names: ptr Vec, srcs: ptr Vec, origins: ptr Vec, errs: ptr Vec)
    // which packages are downloaded over http(s), and where to
    let remote = vec_new()
    let tmps = vec_new()
    for i = 0 to vec_len(names) - 1
      let name = u_get(names, i)
      let tmp = ""
      if fe_valid_name(name) && !str_starts(fe_url(base, name), "file://")
        tmp = fe_tmp()
        vec_push(remote, i)
      end
      u_push(tmps, tmp)
    end
    let fast = false
    if vec_len(remote) > 1
      let args = fe_curl_args()
      u_push(args, "--parallel")
      u_push(args, "--parallel-max")
      u_push(args, "16")
      for k = 0 to vec_len(remote) - 1
        let i = vec_get(remote, k)
        u_push(args, "--output")
        u_push(args, u_get(tmps, i))
        u_push(args, fe_url(base, u_get(names, i)))
      end
      fast = os_run("curl", args) == 0
    end
    for i = 0 to vec_len(names) - 1
      let name = u_get(names, i)
      let tmp = u_get(tmps, i)
      let src = ""
      let origin = ""
      let ok = false
      if fast && tmp != ""
        origin = fe_url(base, name)
        src = io_read_file(tmp, &ok)
        if !ok
          u_fail(u_cat3("can't download package ", u_quote(name), ": the download disappeared"))
        end
      else
        src = fe_fetch(base, name, &origin, &ok)
      end
      if tmp != ""
        syscall(87, cstr(tmp))
      end
      u_push(srcs, src)
      u_push(origins, origin)
      if ok
        u_push(errs, "")
      else
        u_push(errs, pk_err)
      end
    end
  end

  // fe_curl downloads one URL with curl into a temporary file.
  fn fe_curl(name: str, u: str, ok: ptr bool) -> str
    let tmp = fe_tmp()
    let args = fe_curl_args()
    u_push(args, "--output")
    u_push(args, tmp)
    u_push(args, u)
    let status = os_run("curl", args)
    let read = false
    let src = ""
    if status == 0
      src = io_read_file(tmp, &read)
    end
    syscall(87, cstr(tmp))
    if read
      *ok = true
      return src
    end
    if status == -1
      u_fail(u_cat3("can't download package ", u_quote(name), ": curl is not installed"))
    elif status == 6
      u_fail(u_cat4("can't download package ", u_quote(name), ": cannot resolve ", u_cat(fe_host(u), " (offline, or a DNS problem)")))
    elif status == 22
      u_fail(u_cat4("package ", u_quote(name), " not found in registry (", u_cat(u, ")")))
    else
      u_fail(u_cat4("can't download package ", u_quote(name), ": curl failed with status ", str_from_int(status)))
    end
    return ""
  end

  fn fe_host(u: str) -> str
    let start = str_find(u, "://", 0)
    if start < 0
      return u
    end
    start = start + 3
    let stop = str_find_byte(u, '/', start)
    if stop < 0
      stop = len(u)
    end
    return str_slice(u, start, stop)
  end
