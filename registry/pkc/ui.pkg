doc pkc: errors and the -vb report on stderr (port of internal/ui).
  `ui_error(msg, src)` prints an error exactly like the Go compiler: the
  message, the source line with a caret when the error is in the program
  file, and a hint for common problems. Colors follow `rt/term`.

needs std rt pkc/util
code
  const UI_RESET = "\x1b[0m"
  const UI_BOLD = "\x1b[1m"
  const UI_DIM = "\x1b[2m"
  const UI_RED = "\x1b[31m"
  const UI_GREEN = "\x1b[32m"
  const UI_YELLOW = "\x1b[33m"
  const UI_BLUE = "\x1b[34m"
  const UI_MAGENTA = "\x1b[35m"
  const UI_CYAN = "\x1b[36m"

  // ui_c wraps s in the given ANSI codes when colors are on.
  fn ui_c(on: bool, s: str, codes: str) -> str
    if !on || codes == "" || s == ""
      return s
    end
    return u_cat3(codes, s, UI_RESET)
  end

  fn ui_base(path: str) -> str
    let i = len(path) - 1
    while i >= 0 && path[i] != '/'
      i = i - 1
    end
    return str_slice(path, i + 1, len(path))
  end

  fn ui_hint(msg: str) -> str
    if u_has(msg, "cannot resolve") || u_has(msg, "can't reach")
      return "check your internet connection, or build from a local copy of the registry:\n       PACKENGER_REGISTRY=file://$PWD/registry packenger ..."
    elif u_has(msg, "not found in registry")
      return "check the package name in your 'use' line, and that it has been pushed to the registry"
    elif u_has(msg, "is not installed")
      return "install it, e.g. 'sudo pacman -S nasm binutils' or 'sudo apt install nasm binutils'"
    end
    return ""
  end

  // ui_pos splits "file:line:col: message"; it returns false if msg doesn't
  // start with a position.
  fn ui_pos(msg: str, file: ptr str, line: ptr int, col: ptr int, rest: ptr str) -> bool
    // the position is the shortest prefix of the form file:N:N:
    let i = 0
    while i < len(msg)
      let c1 = str_find_byte(msg, ':', i)
      if c1 < 0
        return false
      end
      let c2 = str_find_byte(msg, ':', c1 + 1)
      let c3 = -1
      if c2 >= 0
        c3 = str_find_byte(msg, ':', c2 + 1)
      end
      if c2 >= 0 && c3 >= 0 && c1 > 0 && c3 + 1 < len(msg) && msg[c3 + 1] == ' '
        let ok1 = false
        let ok2 = false
        let l = str_parse_int(str_slice(msg, c1 + 1, c2), &ok1)
        let c = str_parse_int(str_slice(msg, c2 + 1, c3), &ok2)
        if ok1 && ok2 && str_slice(msg, c1 + 1, c2) != "" && msg[c1 + 1] != '-' && msg[c2 + 1] != '-'
          *file = str_slice(msg, 0, c1)
          *line = l
          *col = c
          *rest = str_slice(msg, c3 + 2, len(msg))
          return true
        end
      end
      i = c1 + 1
    end
    return false
  end

  fn ui_error(msg: str, src: str)
    let on = term_colors(2)
    let b = sb_new()
    let nl = str_find_byte(msg, '\n', 0)
    let first = msg
    let rest = ""
    if nl >= 0
      first = str_slice(msg, 0, nl)
      rest = str_slice(msg, nl + 1, len(msg))
    end
    sb_add(b, "\n  ")
    sb_add(b, ui_c(on, "✗ error", u_cat(UI_BOLD, UI_RED)))
    sb_add(b, " ")
    sb_add(b, ui_c(on, first, UI_BOLD))
    sb_add(b, "\n")
    if nl >= 0
      let lines = u_split(rest, '\n')
      for i = 0 to vec_len(lines) - 1
        sb_add(b, u_cat3("    ", u_get(lines, i), "\n"))
      end
    end
    let file = ""
    let line = 0
    let col = 0
    let what = ""
    if src != "" && ui_pos(first, &file, &line, &col, &what) && ui_base(src) == file
      let ok = false
      let text = io_read_file(src, &ok)
      if ok
        let lines = u_split(text, '\n')
        if line >= 1 && line <= vec_len(lines)
          let l = u_replace(u_get(lines, line - 1), "\t", " ")
          let gutter = str_from_int(line)
          sb_add(b, u_cat4("\n    ", ui_c(on, gutter, UI_DIM), " ", ui_c(on, "│", UI_DIM)))
          sb_add(b, u_cat3(" ", l, "\n"))
          let spaces = sb_new()
          for i = 1 to len(gutter)
            sb_byte(spaces, ' ')
          end
          sb_add(b, u_cat4("    ", sb_str(spaces), " ", ui_c(on, "│", UI_DIM)))
          sb_byte(b, ' ')
          for i = 1 to col - 1
            sb_byte(b, ' ')
          end
          sb_add(b, ui_c(on, "^", u_cat(UI_BOLD, UI_RED)))
          sb_byte(b, '\n')
        end
      end
    end
    let hint = ui_hint(msg)
    if hint != ""
      sb_add(b, u_cat4("\n  ", ui_c(on, "hint", u_cat(UI_BOLD, UI_YELLOW)), " ", u_cat(hint, "\n")))
    end
    sb_byte(b, '\n')
    io_err(sb_str(b))
  end
