doc pkc: the command line — the same commands, flags and messages as the Go compiler.
  `pkc_main()` is the whole program; [bootstrap/pkc.pkg](../../../bootstrap/pkc.pkg)
  just calls it. Every command of the Go tool is supported: `build`, `run`,
  `asm`, `tree`, `dump` and `-vb`; see
  [the self-hosting plan](../../self-hosting.md).

needs std rt pkc/util pkc/fetch pkc/lock pkc/pkgfile pkc/ui pkc/lexer pkc/driver pkc/parser pkc/codegen pkc/report pkc/tree
code
  const PKC_DEFAULT_REGISTRY = "https://raw.githubusercontent.com/DominicThemiya/Packenger/main/registry"

  fn pkc_usage() -> str
    let b = sb_new()
    sb_add(b, "packenger: a language where everything is a package.\n\nUsage:\n")
    sb_add(b, "  packenger build <file.pkg> [-o exe]   compile to a native executable\n")
    sb_add(b, "  packenger run   <file.pkg> [-- args]  compile and run\n")
    sb_add(b, "  packenger asm   <file.pkg> [-o file]  print the generated NASM\n")
    sb_add(b, "  packenger tree  <file.pkg>            show which packages built the program\n")
    sb_add(b, "  packenger lock  <file.pkg>            pin the exact version of every package\n")
    sb_add(b, "                                        the program is built from, in\n")
    sb_add(b, "                                        <file>.lock (see docs/publishing.md)\n")
    sb_add(b, "  packenger dump  tokens|ast|asm <file.pkg>\n")
    sb_add(b, "                                        print a compiler stage in a stable text\n")
    sb_add(b, "                                        format (see docs/dumps.md)\n")
    sb_add(b, "  packenger dump  pkg <package>         print a registry package as parsed\n\n")
    sb_add(b, "Flags:\n")
    sb_add(b, "  --registry URL   where packages are hosted (env PACKENGER_REGISTRY;\n")
    sb_add(b, u_cat3("                   default ", PKC_DEFAULT_REGISTRY, ")\n"))
    sb_add(b, "  --target TRUCK   backend truck that translates packages to assembly\n")
    sb_add(b, "                   (default bintables)\n")
    sb_add(b, "  -o FILE          output file\n")
    sb_add(b, "  -vb              verbose build: every package downloaded (and why), the\n")
    sb_add(b, "                   grammar, parse results, chosen backend variants, and the\n")
    sb_add(b, "                   nasm/ld steps, all with sizes and timings (-v is an alias)\n\n")
    sb_add(b, "Requires nasm and ld for build and run.\n")
    return sb_str(b)
  end

  // the parsed command line
  struct PkcArgs
    cmd: str
    registry: str
    registry_set: bool
    target: str
    out: str
    verbose: bool
    pos: ptr Vec
    prog_args: ptr Vec
  end

  fn pkc_is_bool_flag(name: str) -> bool
    return name == "v" || name == "vb"
  end

  // pkc_parse_args mirrors the Go tool: flags may come before or after the
  // positional arguments; for run, arguments after -- go to the program.
  fn pkc_parse_args(argv_: [str], a: ptr PkcArgs) -> bool
    a.cmd = argv_[1]
    a.registry = os_getenv("PACKENGER_REGISTRY")
    if a.registry == ""
      a.registry = PKC_DEFAULT_REGISTRY
    end
    a.target = "bintables"
    a.out = ""
    a.pos = vec_new()
    a.prog_args = vec_new()
    let stop = len(argv_)
    if a.cmd == "run"
      for i = 2 to len(argv_) - 1
        if argv_[i] == "--"
          for j = i + 1 to len(argv_) - 1
            u_push(a.prog_args, argv_[j])
          end
          stop = i
          break
        end
      end
    end
    let i = 2
    while i < stop
      let arg = argv_[i]
      if arg == "--"
        for j = i + 1 to stop - 1
          u_push(a.pos, argv_[j])
        end
        break
      end
      if len(arg) > 1 && arg[0] == '-'
        let name = arg
        while len(name) > 0 && name[0] == '-'
          name = str_slice(name, 1, len(name))
        end
        let value = ""
        let has_value = false
        let eq = str_find_byte(name, '=', 0)
        if eq >= 0
          value = str_slice(name, eq + 1, len(name))
          name = str_slice(name, 0, eq)
          has_value = true
        end
        if pkc_is_bool_flag(name)
          a.verbose = !has_value || value == "true" || value == "1"
        elif name == "registry" || name == "target" || name == "o"
          if !has_value
            if i + 1 >= stop
              io_err(pkc_usage())
              return u_fail(u_cat("flag needs an argument: -", name))
            end
            i = i + 1
            value = argv_[i]
          end
          if name == "registry"
            a.registry = value
            a.registry_set = true
          elif name == "target"
            a.target = value
          else
            a.out = value
          end
        else
          io_err(pkc_usage())
          return u_fail(u_cat("flag provided but not defined: -", name))
        end
      else
        u_push(a.pos, arg)
      end
      i = i + 1
    end
    return true
  end

  // pkc_main runs the compiler and returns the process exit status.
  fn pkc_main() -> int
    let args = argv
    if len(args) < 2 || args[1] == "-h" || args[1] == "--help" || args[1] == "help"
      io_out(pkc_usage())
      io_flush()
      return 0
    end
    let a = new PkcArgs
    let src = ""
    let code = pkc_run(args, a, &src)
    io_flush()
    if code < 0
      ui_error(pk_err, src)
      return 1
    end
    return code
  end

  // pkc_run returns the exit status, or -1 with pk_err set.
  fn pkc_run(args: [str], a: ptr PkcArgs, src: ptr str) -> int
    if !pkc_parse_args(args, a)
      return -1
    end
    let stage = ""
    if a.cmd == "dump"
      if vec_len(a.pos) != 2
        u_fail("usage: packenger dump tokens|ast|asm <file.pkg>, or packenger dump pkg <package>")
        return -1
      end
      stage = u_get(a.pos, 0)
      if stage != "tokens" && stage != "ast" && stage != "asm" && stage != "pkg"
        u_fail(u_cat3("unknown dump ", u_quote(stage), " (tokens, ast, asm or pkg)"))
        return -1
      end
    elif vec_len(a.pos) != 1
      u_fail(u_cat(a.cmd, " expects one source file (see packenger --help)"))
      return -1
    end
    *src = u_get(a.pos, vec_len(a.pos) - 1)
    let exe = a.out
    if a.cmd == "build" && exe == ""
      exe = ui_base(*src)
      if str_ends(exe, ".pkg")
        exe = str_slice(exe, 0, len(exe) - 4)
      end
    end
    // "use pkg_tree" routes packages to registries with pkg_tree.pkg next to
    // the source, unless --registry is given.
    let prefixes = vec_new()
    let bases = vec_new()
    let peek_ok = false
    let peek = ""
    if !(a.cmd == "dump" && stage == "pkg") && io_exists(*src)
      peek = io_read_file(*src, &peek_ok)
    end
    if peek_ok && dr_uses_tree(peek)
      if !fe_read_tree(*src)
        return -1
      end
      if !a.registry_set
        prefixes = fe_tree_prefixes
        bases = fe_tree_bases
        if fe_tree_default != ""
          a.registry = fe_tree_default
        end
      end
    end
    // A lock file next to the source pins the registries (unless --registry
    // is given) and the version of every package. "lock" itself ignores it
    // and pins the registries as they are now.
    let lock_path = lk_path_of(*src)
    if a.cmd == "lock"
      let pinned = ""
      if !lk_pin(a.registry, &pinned)
        return -1
      end
      a.registry = pinned
      for i = 0 to vec_len(bases) - 1
        if !lk_pin(u_get(bases, i), &pinned)
          return -1
        end
        vec_set(bases, i, pinned as int)
      end
      lk_collect = map_new()
    elif !(a.cmd == "dump" && stage == "pkg")
      if !lk_read(lock_path, *src)
        return -1
      end
      if lk_sums != null && !a.registry_set
        a.registry = lk_registry
        prefixes = lk_route_prefixes
        bases = lk_route_bases
      end
    end
    fe_routes(prefixes, bases)
    if a.verbose
      rp_header(a.cmd, *src, exe, a.registry, a.target)
      for i = 0 to vec_len(prefixes) - 1
        rp_route(u_get(prefixes, i), u_get(bases, i))
      end
      if lk_sums != null
        rp_lock(lock_path, map_len(lk_sums))
      end
    end
    if a.cmd == "dump"
      return pkc_dump(a, stage, *src)
    end
    let text = ""
    if !pkc_read(*src, &text)
      return -1
    end
    let r = dr_compile(a.registry, a.target, ui_base(*src), text)
    if r == null
      return -1
    end
    if a.cmd == "asm"
      rp_done("")
      if a.out == ""
        io_out(r.asm)
        return 0
      end
      if !io_write_file(a.out, r.asm)
        u_fail(u_cat3("open ", a.out, ": can't write the file"))
        return -1
      end
      return 0
    elif a.cmd == "tree"
      rp_done("")
      io_out(tr_tree(r, ui_base(*src), a.target))
      return 0
    elif a.cmd == "lock"
      if !io_write_file(lock_path, lk_format(ui_base(*src), a.registry, prefixes, bases, lk_collect))
        u_fail(u_cat3("open ", lock_path, ": can't write the file"))
        return -1
      end
      rp_done("")
      pkc_locked(lock_path, map_len(lk_collect), a.registry, prefixes, bases)
      return 0
    elif a.cmd == "build"
      if !dr_assemble(r.asm, exe, map_get(r.back, "toolchain") as ptr PfFile)
        return -1
      end
      rp_done("")
      return 0
    elif a.cmd == "run"
      let dir = dr_tmpdir("packenger-run-")
      if dir == ""
        u_fail("can't create a temporary directory in /tmp")
        return -1
      end
      let prog = u_cat(dir, "/prog")
      if !dr_assemble(r.asm, prog, map_get(r.back, "toolchain") as ptr PfFile)
        dr_rmdir(dir)
        return -1
      end
      rp_done("running")
      // some targets need a runtime to run their output
      let cmd = prog
      let cargs = a.prog_args
      let runner = dr_run_command(map_get(r.back, "toolchain") as ptr PfFile, prog)
      if runner != null
        cmd = u_get(runner, 0)
        if os_find(cmd) == ""
          dr_rm(prog)
          dr_rmdir(dir)
          u_fail(u_cat4(cmd, " is not installed (target ", a.target, " runs programs with it)"))
          return -1
        end
        cargs = vec_new()
        for i = 1 to vec_len(runner) - 1
          vec_push(cargs, vec_get(runner, i))
        end
        for i = 0 to vec_len(a.prog_args) - 1
          vec_push(cargs, vec_get(a.prog_args, i))
        end
      end
      let status = os_run(cmd, cargs)
      dr_rm(prog)
      dr_rmdir(dir)
      return status
    end
    u_fail(u_cat3("unknown command ", u_quote(a.cmd), " (see packenger --help)"))
    return -1
  end

  // pkc_locked reports a lock file that was written.
  fn pkc_locked(path: str, packages: int, registry: str, prefixes: ptr Vec, bases: ptr Vec)
    let on = term_colors(1)
    io_out(u_cat4("  ", ui_c(on, "✓ locked", u_cat(UI_BOLD, UI_GREEN)), " ", rp_plural(packages, "package", "packages")))
    io_out(u_cat4(" ", ui_c(on, "in", UI_DIM), " ", u_cat(path, "\n")))
    io_out(u_cat4("    ", ui_c(on, "registry", UI_DIM), " ", u_cat(registry, "\n")))
    for i = 0 to vec_len(prefixes) - 1
      io_out(u_cat4("    ", ui_c(on, "route", UI_DIM), " ", u_cat4(u_get(prefixes, i), " ", ui_c(on, "→", UI_DIM), u_cat3(" ", u_get(bases, i), "\n"))))
    end
  end

  fn pkc_dump(a: ptr PkcArgs, stage: str, src: str) -> int
    if stage == "pkg"
      return pkc_dump_pkg(a, src)
    end
    let text = ""
    if !pkc_read(src, &text)
      return -1
    end
    if stage == "tokens"
      let fr = dr_lex(a.registry, ui_base(src), text)
      if fr == null
        return -1
      end
      io_out(lx_dump(fr.toks))
      return 0
    end
    let r = dr_compile(a.registry, a.target, ui_base(src), text)
    if r == null
      return -1
    end
    if stage == "ast"
      io_out(ps_dump(r.prog))
    else
      io_out(r.asm)
    end
    return 0
  end

  // pkc_read reads a source file, with Go's error message if it's missing.
  fn pkc_read(path: str, text: ptr str) -> bool
    if !io_exists(path)
      return u_fail(u_cat3("open ", path, ": no such file or directory"))
    end
    let ok = false
    *text = io_read_file(path, &ok)
    if !ok
      return u_fail(u_cat3("read ", path, ": can't read the file"))
    end
    return true
  end

  fn pkc_dump_pkg(a: ptr PkcArgs, name: str) -> int
    let origin = ""
    let ok = false
    let src = fe_fetch(a.registry, name, &origin, &ok)
    if !ok
      return -1
    end
    let f = pf_parse(name, origin, src)
    if f == null
      return -1
    end
    io_out(pf_dump(f))
    return 0
  end
