doc pkc: the compile pipeline (port of internal/lang/driver.go).
  So far: reading `use` lines, fetching packages in rounds, building the
  grammar and tokenizing (`dr_lex`), lexing library code and parsing
  (`dr_parse`), then fetching the backend packages and rendering NASM
  (`dr_compile`).

needs std rt pkc/util pkc/fetch pkc/lock pkc/pkgfile pkc/lexer pkc/lang pkc/parser pkc/codegen pkc/report
code
  // a package to fetch, and why it is needed (for the -vb report)
  struct DrDep
    name: str
    why: str
  end

  struct DrFront
    toks: ptr Vec
    lang: ptr Lang
    front: ptr Map
    uses: ptr Vec
  end

  // dr_scan_uses reads the use lines, which must come before any code, and
  // blanks them out (keeping line numbers).
  fn dr_scan_uses(src: str, uses: ptr Vec, body: ptr str) -> bool
    let lines = u_split(src, '\n')
    for i = 0 to vec_len(lines) - 1
      let t = u_trim(u_get(lines, i))
      if t == "" || str_starts(t, "//")
        continue
      end
      if !(str_starts(t, "use") && len(t) > 3 && u_is_space(t[3]))
        break
      end
      let j = 3
      while j < len(t) && u_is_space(t[j])
        j = j + 1
      end
      let k = j
      while k < len(t) && !u_is_space(t[k])
        k = k + 1
      end
      let rest = u_trim(str_slice(t, k, len(t)))
      if rest != "" && !str_starts(rest, "//")
        break
      end
      // the package tree is read by the caller, not fetched
      if str_slice(t, j, k) != "pkg_tree"
        u_push(uses, str_slice(t, j, k))
      end
      vec_set(lines, i, "" as int)
    end
    if vec_len(uses) == 0
      return u_fail("the file does not use any packages, so it has no syntax; start it with 'use std'")
    end
    *body = u_join(lines, "\n")
    return true
  end

  // dr_uses_tree reports whether source src has the line "use pkg_tree",
  // which routes its packages with the pkg_tree.pkg next to it.
  fn dr_uses_tree(src: str) -> bool
    let lines = u_split(src, '\n')
    for i = 0 to vec_len(lines) - 1
      let t = u_trim(u_get(lines, i))
      if t == "" || str_starts(t, "//")
        continue
      end
      if !(str_starts(t, "use") && len(t) > 3 && u_is_space(t[3]))
        return false
      end
      let j = 3
      while j < len(t) && u_is_space(t[j])
        j = j + 1
      end
      let k = j
      while k < len(t) && !u_is_space(t[k])
        k = k + 1
      end
      let rest = u_trim(str_slice(t, k, len(t)))
      if rest != "" && !str_starts(rest, "//")
        return false
      end
      if str_slice(t, j, k) == "pkg_tree"
        return true
      end
    end
    return false
  end

  fn dr_dep(name: str, why: str) -> ptr DrDep
    let d = new DrDep
    d.name = name
    d.why = why
    return d
  end

  // dr_fetch_all downloads packages level by level. mode "syntax" follows
  // truck members and needs; any other mode is a backend truck name, and
  // follows @includes and needs.
  fn dr_fetch_all(reg: str, mode: str, first: ptr Vec) -> ptr Map
    let got = map_new()
    let seen = map_new()
    let pending = vec_new()
    for i = 0 to vec_len(first) - 1
      let d = vec_get(first, i) as ptr DrDep
      if !map_has(seen, d.name)
        map_set(seen, d.name, 1)
        vec_push(pending, d as int)
      end
    end
    let phase = mode
    let start = time_now()
    let bytes = 0
    let round = 0
    while vec_len(pending) > 0
      let batch = pending
      pending = vec_new()
      round = round + 1
      let fetches = vec_new()
      let names = vec_new()
      for i = 0 to vec_len(batch) - 1
        u_push(names, (vec_get(batch, i) as ptr DrDep).name)
      end
      let srcs = vec_new()
      let origins = vec_new()
      let errs = vec_new()
      let t0 = time_now()
      fe_fetch_batch(reg, names, srcs, origins, errs)
      let took = time_now() - t0
      for i = 0 to vec_len(batch) - 1
        let d = vec_get(batch, i) as ptr DrDep
        if u_get(errs, i) != ""
          pk_err = u_get(errs, i)
          return null
        end
        let src = u_get(srcs, i)
        let f = pf_parse(d.name, u_get(origins, i), src)
        if f == null
          return null
        end
        if lk_sums != null || lk_collect != null
          let sum = sha256_hex(src)
          if lk_sums != null && !lk_check(d.name, sum)
            return null
          end
          if lk_collect != null
            map_set(lk_collect, f.name, sum as int)
          end
        end
        let rf = new RpFetch
        rf.name = f.name
        rf.why = d.why
        rf.size = len(src)
        rf.took = took
        vec_push(fetches, rf as int)
        bytes = bytes + len(src)
        map_set(got, f.name, f as int)
        let next_ = dr_next(f, mode)
        for k = 0 to vec_len(next_) - 1
          let nd = vec_get(next_, k) as ptr DrDep
          if !map_has(seen, nd.name)
            map_set(seen, nd.name, 1)
            vec_push(pending, nd as int)
          end
        end
      end
      rp_round(phase, round, fetches)
    end
    rp_phase_done(phase, map_len(got), bytes, time_now() - start)
    return got
  end

  fn dr_next(f: ptr PfFile, mode: str) -> ptr Vec
    let out = vec_new()
    for i = 0 to vec_len(f.truck) - 1
      vec_push(out, dr_dep(u_cat3(f.name, "/", u_get(f.truck, i)), u_cat("member of truck ", f.name)) as int)
    end
    if mode != "syntax"
      let incs = cg_includes(f)
      for i = 0 to vec_len(incs) - 1
        vec_push(out, dr_dep(u_cat3(mode, "/", u_get(incs, i)), u_cat("included by ", f.name)) as int)
      end
    end
    for i = 0 to vec_len(f.needs) - 1
      vec_push(out, dr_dep(u_get(f.needs, i), u_cat("needed by ", f.name)) as int)
    end
    return out
  end

  // dr_lex runs the pipeline up to tokenizing.
  fn dr_lex(reg: str, file: str, src: str) -> ptr DrFront
    let uses = vec_new()
    let body = ""
    if !dr_scan_uses(src, uses, &body)
      pk_err = u_cat3(file, ": ", pk_err)
      return null
    end
    rp_uses(uses)
    let first = vec_new()
    for i = 0 to vec_len(uses) - 1
      vec_push(first, dr_dep(u_get(uses, i), u_cat("used by ", file)) as int)
    end
    let front = dr_fetch_all(reg, "syntax", first)
    if front == null
      return null
    end
    let names = vec_new()
    for i = 0 to map_len(front) - 1
      if !(map_value(front, i) as ptr PfFile).is_truck
        u_push(names, map_key(front, i))
      end
    end
    u_sort_strs(names)
    let pkgs = vec_new()
    for i = 0 to vec_len(names) - 1
      vec_push(pkgs, map_get(front, u_get(names, i)))
    end
    let L = lg_new(pkgs)
    if L == null
      return null
    end
    let keywords = vec_new()
    for i = 0 to map_len(L.keywords) - 1
      u_push(keywords, map_key(L.keywords, i))
    end
    u_sort_strs(keywords)
    rp_grammar(vec_len(pkgs), lg_forms(L), map_len(L.infix), map_len(L.prefix), keywords, L.puncts)
    let toks = lx_lex(body, file, L.puncts, false)
    if toks == null
      return null
    end
    let r = new DrFront
    r.toks = toks
    r.lang = L
    r.front = front
    r.uses = uses
    return r
  end

  // dr_library_units lexes the code sections of the loaded packages, in
  // name order, with positions in the package files.
  fn dr_library_units(front: ptr Map, L: ptr Lang) -> ptr Vec
    let names = vec_new()
    for i = 0 to map_len(front) - 1
      u_push(names, map_key(front, i))
    end
    u_sort_strs(names)
    let units = vec_new()
    for i = 0 to vec_len(names) - 1
      let f = map_get(front, u_get(names, i)) as ptr PfFile
      if f.code == null
        continue
      end
      let toks = lx_lex(u_join(f.code, "\n"), u_cat(f.name, ".pkg"), L.puncts, false)
      if toks == null
        return null
      end
      for k = 0 to vec_len(toks) - 1
        let t = lx_tok(toks, k)
        t.line = t.line + f.code_at - 1
        t.col = t.col + 2
      end
      let u = new PUnit
      u.name = f.name
      u.toks = toks
      u.lib = true
      vec_push(units, u as int)
    end
    return units
  end

  // dr_parse runs the pipeline up to the syntax tree.
  fn dr_parse(fr: ptr DrFront, file: str) -> ptr PProg
    let units = dr_library_units(fr.front, fr.lang)
    if units == null
      return null
    end
    let u = new PUnit
    u.name = file
    u.toks = fr.toks
    vec_push(units, u as int)
    return ps_parse(fr.lang, units)
  end

  struct DrResult
    asm: str
    prog: ptr PProg
    front: ptr DrFront
    back: ptr Map
    gen: ptr Gen
  end

  fn dr_count(n: ptr PNode) -> int
    let c = 1
    for i = 0 to ps_nslots(n) - 1
      c = c + dr_count(ps_nd(n.svals, i))
    end
    for i = 0 to ps_nitems(n) - 1
      c = c + dr_count(ps_nd(n.items, i))
    end
    return c
  end

  // dr_compile runs the whole pipeline up to the NASM source.
  fn dr_compile(reg: str, target: str, file: str, src: str) -> ptr DrResult
    let fr = dr_lex(reg, file, src)
    if fr == null
      return null
    end
    let t0 = time_now()
    let prog = dr_parse(fr, file)
    if prog == null
      return null
    end
    let nodes = dr_count(prog.main)
    for i = 0 to vec_len(prog.funcs) - 1
      nodes = nodes + dr_count(ps_nd(prog.funcs, i))
    end
    rp_parsed_file(file, vec_len(fr.toks), nodes, ps_nitems(prog.main), time_now() - t0)
    for i = 0 to vec_len(prog.funcs) - 1
      let f = ps_nd(prog.funcs, i).frame
      rp_parsed_fn(f.name, f.params, f.slots, ps_frame_size(f))
    end
    let kinds = cg_kinds(prog)
    let need = vec_new()
    for i = 0 to vec_len(kinds) - 1
      let k = u_get(kinds, i)
      vec_push(need, dr_dep(u_cat3(target, "/", k), u_cat("translates ", k)) as int)
    end
    if lk_collect != null
      // making a lock: pin the whole backend truck
      vec_push(need, dr_dep(target, "locked whole") as int)
    end
    let by_name = dr_fetch_all(reg, target, need)
    if by_name == null
      return null
    end
    let back = map_new()
    for i = 0 to map_len(by_name) - 1
      let f = map_value(by_name, i) as ptr PfFile
      if !f.is_truck
        map_set(back, pf_kind(f.name), f as int)
      end
    end
    t0 = time_now()
    let g = cg_new(target, back, prog)
    let asm = cg_program(g, prog)
    if asm == ""
      return null
    end
    let lines = 0
    for i = 0 to len(asm) - 1
      if asm[i] == '\n'
        lines = lines + 1
      end
    end
    rp_emitted(lines, time_now() - t0, g.chosen)
    let r = new DrResult
    r.asm = asm
    r.prog = prog
    r.front = fr
    r.back = back
    r.gen = g
    return r
  end

  global dr_tmp_count: int

  // dr_tmpdir makes a new private directory under /tmp.
  fn dr_tmpdir(prefix: str) -> str
    while true
      dr_tmp_count = dr_tmp_count + 1
      let dir = u_cat4("/tmp/", prefix, str_from_int(syscall(39)), u_cat("-", str_from_int(dr_tmp_count)))
      // mkdir(dir, 0700)
      let r = syscall(83, cstr(dir), 448)
      if r == 0
        return dir
      end
      if r != -17
        return ""
      end
    end
    return ""
  end

  fn dr_rm(path: str)
    syscall(87, cstr(path))
  end

  fn dr_rmdir(dir: str)
    syscall(84, cstr(dir))
  end

  // dr_toolchain reads a toolchain package: the source file name, the
  // commands (each a Vec of words) and the distinct tools they run.
  fn dr_toolchain(tc: ptr PfFile, file: ptr str, cmds: ptr Vec, tools: ptr Vec) -> bool
    if tc == null
      return u_fail("the target has no toolchain package")
    end
    *file = ""
    for i = 0 to vec_len(tc.emits) - 1
      let e = vec_get(tc.emits, i) as ptr PfEmit
      for k = 0 to vec_len(e.lines) - 1
        let l = u_get(e.lines, k)
        if e.section == "file"
          let t = u_trim(l)
          if t != "" && *file == ""
            *file = t
          end
        elif e.section == ""
          let f = u_fields(l)
          if vec_len(f) > 0
            vec_push(cmds, f as int)
            if !u_in(tools, u_get(f, 0))
              u_push(tools, u_get(f, 0))
            end
          end
        end
      end
    end
    if *file == "" || vec_len(cmds) == 0
      return u_fail(u_cat(tc.name, " needs an 'emit file' section naming the source file and an 'emit' section of commands"))
    end
    return true
  end

  // dr_run_command is how to run an executable built for the target, from
  // the toolchain package's "emit run" section with {out} replaced by exe;
  // null means it runs by itself.
  fn dr_run_command(tc: ptr PfFile, exe: str) -> ptr Vec
    if tc == null
      return null
    end
    for i = 0 to vec_len(tc.emits) - 1
      let e = vec_get(tc.emits, i) as ptr PfEmit
      if e.section == "run"
        for k = 0 to vec_len(e.lines) - 1
          let f = u_fields(u_get(e.lines, k))
          if vec_len(f) > 0
            let out = vec_new()
            for j = 0 to vec_len(f) - 1
              u_push(out, u_replace(u_get(f, j), "{out}", exe))
            end
            return out
          end
        end
      end
    end
    return null
  end

  // dr_assemble turns the generated source into an executable with the
  // commands of the target's toolchain package, run in a temporary
  // directory, with {out} replaced by the executable's absolute path.
  fn dr_assemble(asm: str, out: str, tc: ptr PfFile) -> bool
    let file = ""
    let cmds = vec_new()
    let tools = vec_new()
    if !dr_toolchain(tc, &file, cmds, tools)
      return false
    end
    let abs = out
    if !str_starts(out, "/")
      abs = u_cat3(os_cwd(), "/", out)
    end
    let dir = dr_tmpdir("packenger-")
    if dir == ""
      return u_fail("can't create a temporary directory in /tmp")
    end
    let ok = dr_assemble_in(asm, abs, dir, file, cmds, tools, tc)
    os_remove_all(dir)
    if ok
      let read = false
      let exe = io_read_file(out, &read)
      if read
        rp_built(out, len(exe))
      end
    end
    return ok
  end

  fn dr_assemble_in(asm: str, abs: str, dir: str, file: str, cmds: ptr Vec, tools: ptr Vec, tc: ptr PfFile) -> bool
    let path = u_cat3(dir, "/", file)
    if !io_write_file(path, asm)
      return u_fail(u_cat3("open ", path, ": can't write the file"))
    end
    // the tools run inside the temporary directory with relative names, so
    // the source name they record is always the same: builds are
    // reproducible
    let target = u_get(u_split(tc.name, '/'), 0)
    for i = 0 to vec_len(cmds) - 1
      let words = vec_get(cmds, i) as ptr Vec
      let name = u_get(words, 0)
      if os_find(name) == ""
        return u_fail(u_cat4(name, " is not installed (target ", target, u_cat3(" needs ", u_join(tools, " and "), ")")))
      end
      let args = vec_new()
      for k = 1 to vec_len(words) - 1
        u_push(args, u_replace(u_get(words, k), "{out}", abs))
      end
      if !dr_tool(dir, name, args)
        return false
      end
    end
    return true
  end

  fn dr_tool(dir: str, name: str, args: ptr Vec) -> bool
    let output = ""
    let t0 = time_now()
    let status = os_run_in(dir, name, args, &output)
    if status != 0
      return u_fail(u_cat4(name, " failed: exit status ", str_from_int(status), u_cat("\n", output)))
    end
    rp_tool(name, time_now() - t0)
    return true
  end
