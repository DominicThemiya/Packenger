doc pkc: the compile pipeline (port of internal/lang/driver.go).
  So far: reading `use` lines, fetching packages in rounds, building the
  grammar and tokenizing (`dr_lex`), lexing library code and parsing
  (`dr_parse`), then fetching the backend packages and rendering NASM
  (`dr_compile`).

needs std rt pkc/util pkc/fetch pkc/pkgfile pkc/lexer pkc/lang pkc/parser pkc/codegen
code
  // a package to fetch, and why it is needed (for the -vb report)
  struct DrDep
    name: str
    why: str
  end

  struct DrFront
    toks: ptr Vec
    lang: ptr Lang
    front: ptr Map
    uses: ptr Vec
  end

  // dr_scan_uses reads the use lines, which must come before any code, and
  // blanks them out (keeping line numbers).
  fn dr_scan_uses(src: str, uses: ptr Vec, body: ptr str) -> bool
    let lines = u_split(src, '\n')
    for i = 0 to vec_len(lines) - 1
      let t = u_trim(u_get(lines, i))
      if t == "" || str_starts(t, "//")
        continue
      end
      if !(str_starts(t, "use") && len(t) > 3 && u_is_space(t[3]))
        break
      end
      let j = 3
      while j < len(t) && u_is_space(t[j])
        j = j + 1
      end
      let k = j
      while k < len(t) && !u_is_space(t[k])
        k = k + 1
      end
      let rest = u_trim(str_slice(t, k, len(t)))
      if rest != "" && !str_starts(rest, "//")
        break
      end
      u_push(uses, str_slice(t, j, k))
      vec_set(lines, i, "" as int)
    end
    if vec_len(uses) == 0
      return u_fail("the file does not use any packages, so it has no syntax; start it with 'use std'")
    end
    *body = u_join(lines, "\n")
    return true
  end

  fn dr_dep(name: str, why: str) -> ptr DrDep
    let d = new DrDep
    d.name = name
    d.why = why
    return d
  end

  // dr_fetch_all downloads packages level by level. mode "syntax" follows
  // truck members and needs; any other mode is a backend truck name, and
  // follows @includes and needs.
  fn dr_fetch_all(reg: str, mode: str, first: ptr Vec) -> ptr Map
    let got = map_new()
    let seen = map_new()
    let pending = vec_new()
    for i = 0 to vec_len(first) - 1
      let d = vec_get(first, i) as ptr DrDep
      if !map_has(seen, d.name)
        map_set(seen, d.name, 1)
        vec_push(pending, d as int)
      end
    end
    while vec_len(pending) > 0
      let batch = pending
      pending = vec_new()
      for i = 0 to vec_len(batch) - 1
        let d = vec_get(batch, i) as ptr DrDep
        let origin = ""
        let ok = false
        let src = fe_fetch(reg, d.name, &origin, &ok)
        if !ok
          return null
        end
        let f = pf_parse(d.name, origin, src)
        if f == null
          return null
        end
        map_set(got, f.name, f as int)
        let next_ = dr_next(f, mode)
        for k = 0 to vec_len(next_) - 1
          let nd = vec_get(next_, k) as ptr DrDep
          if !map_has(seen, nd.name)
            map_set(seen, nd.name, 1)
            vec_push(pending, nd as int)
          end
        end
      end
    end
    return got
  end

  fn dr_next(f: ptr PfFile, mode: str) -> ptr Vec
    let out = vec_new()
    if mode == "syntax"
      for i = 0 to vec_len(f.truck) - 1
        vec_push(out, dr_dep(u_cat3(f.name, "/", u_get(f.truck, i)), u_cat("member of truck ", f.name)) as int)
      end
    end
    if mode != "syntax"
      let incs = cg_includes(f)
      for i = 0 to vec_len(incs) - 1
        vec_push(out, dr_dep(u_cat3(mode, "/", u_get(incs, i)), u_cat("included by ", f.name)) as int)
      end
    end
    for i = 0 to vec_len(f.needs) - 1
      vec_push(out, dr_dep(u_get(f.needs, i), u_cat("needed by ", f.name)) as int)
    end
    return out
  end

  // dr_lex runs the pipeline up to tokenizing.
  fn dr_lex(reg: str, file: str, src: str) -> ptr DrFront
    let uses = vec_new()
    let body = ""
    if !dr_scan_uses(src, uses, &body)
      pk_err = u_cat3(file, ": ", pk_err)
      return null
    end
    let first = vec_new()
    for i = 0 to vec_len(uses) - 1
      vec_push(first, dr_dep(u_get(uses, i), u_cat("used by ", file)) as int)
    end
    let front = dr_fetch_all(reg, "syntax", first)
    if front == null
      return null
    end
    let names = vec_new()
    for i = 0 to map_len(front) - 1
      if !(map_value(front, i) as ptr PfFile).is_truck
        u_push(names, map_key(front, i))
      end
    end
    u_sort_strs(names)
    let pkgs = vec_new()
    for i = 0 to vec_len(names) - 1
      vec_push(pkgs, map_get(front, u_get(names, i)))
    end
    let L = lg_new(pkgs)
    if L == null
      return null
    end
    let toks = lx_lex(body, file, L.puncts, false)
    if toks == null
      return null
    end
    let r = new DrFront
    r.toks = toks
    r.lang = L
    r.front = front
    r.uses = uses
    return r
  end

  // dr_library_units lexes the code sections of the loaded packages, in
  // name order, with positions in the package files.
  fn dr_library_units(front: ptr Map, L: ptr Lang) -> ptr Vec
    let names = vec_new()
    for i = 0 to map_len(front) - 1
      u_push(names, map_key(front, i))
    end
    u_sort_strs(names)
    let units = vec_new()
    for i = 0 to vec_len(names) - 1
      let f = map_get(front, u_get(names, i)) as ptr PfFile
      if f.code == null
        continue
      end
      let toks = lx_lex(u_join(f.code, "\n"), u_cat(f.name, ".pkg"), L.puncts, false)
      if toks == null
        return null
      end
      for k = 0 to vec_len(toks) - 1
        let t = lx_tok(toks, k)
        t.line = t.line + f.code_at - 1
        t.col = t.col + 2
      end
      let u = new PUnit
      u.name = f.name
      u.toks = toks
      u.lib = true
      vec_push(units, u as int)
    end
    return units
  end

  // dr_parse runs the pipeline up to the syntax tree.
  fn dr_parse(fr: ptr DrFront, file: str) -> ptr PProg
    let units = dr_library_units(fr.front, fr.lang)
    if units == null
      return null
    end
    let u = new PUnit
    u.name = file
    u.toks = fr.toks
    vec_push(units, u as int)
    return ps_parse(fr.lang, units)
  end

  struct DrResult
    asm: str
    prog: ptr PProg
    front: ptr DrFront
    back: ptr Map
    gen: ptr Gen
  end

  // dr_compile runs the whole pipeline up to the NASM source.
  fn dr_compile(reg: str, target: str, file: str, src: str) -> ptr DrResult
    let fr = dr_lex(reg, file, src)
    if fr == null
      return null
    end
    let prog = dr_parse(fr, file)
    if prog == null
      return null
    end
    let kinds = cg_kinds(prog)
    let need = vec_new()
    for i = 0 to vec_len(kinds) - 1
      let k = u_get(kinds, i)
      vec_push(need, dr_dep(u_cat3(target, "/", k), u_cat("translates ", k)) as int)
    end
    let by_name = dr_fetch_all(reg, target, need)
    if by_name == null
      return null
    end
    let back = map_new()
    for i = 0 to map_len(by_name) - 1
      let f = map_value(by_name, i) as ptr PfFile
      map_set(back, pf_kind(f.name), f as int)
    end
    let g = cg_new(target, back, prog)
    let asm = cg_program(g, prog)
    if asm == ""
      return null
    end
    let r = new DrResult
    r.asm = asm
    r.prog = prog
    r.front = fr
    r.back = back
    r.gen = g
    return r
  end

  global dr_tmp_count: int

  // dr_tmpdir makes a new private directory under /tmp.
  fn dr_tmpdir(prefix: str) -> str
    while true
      dr_tmp_count = dr_tmp_count + 1
      let dir = u_cat4("/tmp/", prefix, str_from_int(syscall(39)), u_cat("-", str_from_int(dr_tmp_count)))
      // mkdir(dir, 0700)
      let r = syscall(83, cstr(dir), 448)
      if r == 0
        return dir
      end
      if r != -17
        return ""
      end
    end
    return ""
  end

  fn dr_rm(path: str)
    syscall(87, cstr(path))
  end

  fn dr_rmdir(dir: str)
    syscall(84, cstr(dir))
  end

  // dr_assemble turns NASM source into an executable with nasm and ld.
  fn dr_assemble(asm: str, out: str) -> bool
    let dir = dr_tmpdir("packenger-")
    if dir == ""
      return u_fail("can't create a temporary directory in /tmp")
    end
    let asm_path = u_cat(dir, "/prog.asm")
    let obj_path = u_cat(dir, "/prog.o")
    let ok = dr_assemble_in(asm, out, asm_path, obj_path)
    dr_rm(asm_path)
    dr_rm(obj_path)
    dr_rmdir(dir)
    return ok
  end

  fn dr_assemble_in(asm: str, out: str, asm_path: str, obj_path: str) -> bool
    if !io_write_file(asm_path, asm)
      return u_fail(u_cat3("open ", asm_path, ": can't write the file"))
    end
    // nasm runs inside the temporary directory with relative names, so the
    // source name it records is always prog.asm: builds are reproducible
    let nasm = vec_new()
    u_push(nasm, "-f")
    u_push(nasm, "elf64")
    u_push(nasm, "-o")
    u_push(nasm, "prog.o")
    u_push(nasm, "prog.asm")
    let dir = str_slice(asm_path, 0, len(asm_path) - 9)
    if !dr_tool(dir, "nasm", nasm)
      return false
    end
    let ld = vec_new()
    u_push(ld, "-o")
    u_push(ld, out)
    u_push(ld, obj_path)
    return dr_tool("", "ld", ld)
  end

  fn dr_tool(dir: str, name: str, args: ptr Vec) -> bool
    if os_find(name) == ""
      return u_fail(u_cat(name, " is not installed (packenger needs nasm and ld)"))
    end
    let output = ""
    let status = 0
    if dir != ""
      status = os_run_in(dir, name, args, &output)
    else
      status = os_run_output(name, args, &output)
    end
    if status != 0
      return u_fail(u_cat4(name, " failed: exit status ", str_from_int(status), u_cat("\n", output)))
    end
    return true
  end
