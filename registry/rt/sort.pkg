doc Sorting: vectors of ints or strings, or of anything, with a comparison function.
  ```
  let names = vec_new()
  vec_push(names, "pear" as int)
  vec_push(names, "fig" as int)
  sort_strs(names)                    // fig, pear

  fn longer(a: int, b: int) -> bool   // the items are words: convert with as
    return len(a as str) > len(b as str)
  end
  sort_by(names, longer)              // pear, fig
  ```

  | function | does |
  |---|---|
  | `sort_ints(v: ptr Vec)` | ints, ascending |
  | `sort_strs(v: ptr Vec)` | strings, in byte order (`str_cmp`) |
  | `sort_by(v: ptr Vec, less: fn(int, int) -> bool)` | by `less(a, b)`: true when `a` goes before `b` |
  | `sort_slice(xs: [int], less: fn(int, int) -> bool)` | an `[int]` slice, the same way |
  | `sort_int_less(a: int, b: int) -> bool` | `a < b`, for `sort_by` |
  | `sort_str_less(a: int, b: int) -> bool` | strings in byte order, for `sort_by` |

  Every sort is a stable merge sort: O(n log n) comparisons, and items that
  compare equal keep their order, so sorting by one key and then another
  sorts by both.

needs std rt/vec rt/str
code
  fn sort_int_less(a: int, b: int) -> bool
    return a < b
  end

  fn sort_str_less(a: int, b: int) -> bool
    return str_cmp(a as str, b as str) < 0
  end

  // sort_words sorts xs[0:n], merging runs of 1, 2, 4, ... items through
  // a buffer. A right item goes first only if it is strictly less, which
  // keeps the sort stable.
  fn sort_words(xs: [int], n: int, less: fn(int, int) -> bool)
    if n < 2
      return
    end
    let tmp = make([int], n)
    let width = 1
    while width < n
      let lo = 0
      while lo < n - width
        let mid = lo + width
        let hi = mid + width
        if hi > n
          hi = n
        end
        let i = lo
        let j = mid
        let k = lo
        while i < mid && j < hi
          if less(xs[j], xs[i])
            tmp[k] = xs[j]
            j = j + 1
          else
            tmp[k] = xs[i]
            i = i + 1
          end
          k = k + 1
        end
        while i < mid
          tmp[k] = xs[i]
          i = i + 1
          k = k + 1
        end
        while j < hi
          tmp[k] = xs[j]
          j = j + 1
          k = k + 1
        end
        for m = lo to hi - 1
          xs[m] = tmp[m]
        end
        lo = lo + 2 * width
      end
      width = width * 2
    end
  end

  fn sort_by(v: ptr Vec, less: fn(int, int) -> bool)
    sort_words(v.data, v.len, less)
  end

  fn sort_slice(xs: [int], less: fn(int, int) -> bool)
    sort_words(xs, len(xs), less)
  end

  fn sort_ints(v: ptr Vec)
    sort_by(v, sort_int_less)
  end

  fn sort_strs(v: ptr Vec)
    sort_by(v, sort_str_less)
  end
