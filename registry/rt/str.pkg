doc Strings: slicing, searching, joining, numbers, and a string builder.
  Strings are immutable: these functions return new strings and never
  change their arguments. A string is a pointer to a `qword` length, the
  bytes, and a zero byte (so it also works as a C string).

  ```
  let s = str_concat("pack", "enger")
  print str_slice(s, 0, 4)               // pack
  print str_find(s, "eng", 0)            // 4
  print str_from_int(-42)                // -42

  let b = sb_new()
  sb_add(b, "x = ")
  sb_int(b, 7)
  print sb_str(b)                        // x = 7
  ```

  | function | does |
  |---|---|
  | `str_alloc(n: int) -> str` | a new string of `n` zero bytes, to fill in through `cstr` before sharing it |
  | `str_from(p: ptr u8, n: int) -> str` | copy `n` bytes into a new string |
  | `str_slice(s: str, start: int, stop: int) -> str` | the bytes from `start` up to (not including) `stop`, clamped to the string |
  | `str_concat(a: str, b: str) -> str` | `a` followed by `b` |
  | `str_starts(s: str, prefix: str) -> bool` | does `s` begin with `prefix` |
  | `str_ends(s: str, suffix: str) -> bool` | does `s` end with `suffix` |
  | `str_find(s: str, sub: str, from: int) -> int` | first index of `sub` at or after `from`, or -1 |
  | `str_find_byte(s: str, c: u8, from: int) -> int` | first index of byte `c` at or after `from`, or -1 |
  | `str_cmp(a: str, b: str) -> int` | negative, zero or positive, comparing bytes |
  | `str_hash(s: str) -> int` | FNV-1a hash of the bytes |
  | `str_from_int(n: int) -> str` | decimal digits, with `-` if negative |
  | `str_parse_int(s: str, ok: ptr bool) -> int` | parse an optionally negative decimal; `*ok` is false if `s` isn't one or doesn't fit in an `int` |
  | `str_pad(s: str, width: int) -> str` | add spaces on the right up to `width` bytes |
  | `str_lpad(s: str, width: int) -> str` | add spaces on the left up to `width` bytes |

  The builder (`StrBuf`) collects pieces and makes one string at the end:
  `sb_new()`, `sb_add(b, s)`, `sb_bytes(b, p, n)`, `sb_byte(b, c)`, `sb_int(b, n)`,
  `sb_len(b)`, `sb_str(b) -> str` (a copy) and `sb_clear(b)`.

needs std rt/mem
code
  fn str_alloc(n: int) -> str
    let p = mem_alloc(n + 9)
    *(p as ptr int) = n
    return p as str
  end

  fn str_from(p: ptr u8, n: int) -> str
    let s = str_alloc(n)
    mem_copy(cstr(s), p, n)
    return s
  end

  fn str_slice(s: str, start: int, stop: int) -> str
    if start < 0
      start = 0
    end
    if stop > len(s)
      stop = len(s)
    end
    if stop <= start
      return ""
    end
    return str_from(mem_add(cstr(s), start), stop - start)
  end

  fn str_concat(a: str, b: str) -> str
    let s = str_alloc(len(a) + len(b))
    mem_copy(cstr(s), cstr(a), len(a))
    mem_copy(mem_add(cstr(s), len(a)), cstr(b), len(b))
    return s
  end

  fn str_starts(s: str, prefix: str) -> bool
    return len(prefix) <= len(s) && mem_eq(cstr(s), cstr(prefix), len(prefix))
  end

  fn str_ends(s: str, suffix: str) -> bool
    let at = len(s) - len(suffix)
    return at >= 0 && mem_eq(mem_add(cstr(s), at), cstr(suffix), len(suffix))
  end

  fn str_find(s: str, sub: str, from: int) -> int
    if from < 0
      from = 0
    end
    let last = len(s) - len(sub)
    let i = from
    while i <= last
      if mem_eq(mem_add(cstr(s), i), cstr(sub), len(sub))
        return i
      end
    next
      i = i + 1
    end
    return -1
  end

  fn str_find_byte(s: str, c: u8, from: int) -> int
    if from < 0
      from = 0
    end
    let i = from
    while i < len(s)
      if s[i] == c
        return i
      end
    next
      i = i + 1
    end
    return -1
  end

  fn str_cmp(a: str, b: str) -> int
    let n = len(a)
    if len(b) < n
      n = len(b)
    end
    for i = 0 to n - 1
      if a[i] != b[i]
        return (a[i] as int) - (b[i] as int)
      end
    end
    return len(a) - len(b)
  end

  fn str_hash(s: str) -> int
    let h = -3750763034362895579
    for i = 0 to len(s) - 1
      h = (h ^ (s[i] as int)) * 1099511628211
    end
    return h
  end

  fn str_from_int(n: int) -> str
    if n == 0
      return "0"
    end
    let buf = mem_alloc(24)
    let i = 24
    let m = n
    while m != 0
      let d = m % 10
      if d < 0
        d = -d
      end
      i = i - 1
      *mem_add(buf, i) = (48 + d) as u8
      m = m / 10
    end
    if n < 0
      i = i - 1
      *mem_add(buf, i) = '-'
    end
    return str_from(mem_add(buf, i), 24 - i)
  end

  fn str_parse_int(s: str, ok: ptr bool) -> int
    let i = 0
    let neg = false
    if len(s) > 0 && s[0] == '-'
      neg = true
      i = 1
    end
    if i >= len(s)
      *ok = false
      return 0
    end
    // accumulate negatively, so the most negative value fits
    let n = 0
    let min = -9223372036854775807 - 1
    while i < len(s)
      let c = s[i]
      if c < '0' || c > '9'
        *ok = false
        return 0
      end
      let d = (c as int) - 48
      if n < (min + d) / 10
        *ok = false
        return 0
      end
      n = n * 10 - d
    next
      i = i + 1
    end
    if !neg && n == min
      *ok = false
      return 0
    end
    *ok = true
    if neg
      return n
    end
    return -n
  end

  fn str_pad(s: str, width: int) -> str
    if len(s) >= width
      return s
    end
    let out = str_alloc(width)
    mem_copy(cstr(out), cstr(s), len(s))
    mem_set(mem_add(cstr(out), len(s)), ' ', width - len(s))
    return out
  end

  fn str_lpad(s: str, width: int) -> str
    if len(s) >= width
      return s
    end
    let out = str_alloc(width)
    mem_set(cstr(out), ' ', width - len(s))
    mem_copy(mem_add(cstr(out), width - len(s)), cstr(s), len(s))
    return out
  end

  struct StrBuf
    data: ptr u8
    len: int
    cap: int
  end

  fn sb_new() -> ptr StrBuf
    let b = new StrBuf
    b.cap = 64
    b.data = mem_alloc(b.cap)
    return b
  end

  fn sb_reserve(b: ptr StrBuf, more: int)
    if b.len + more <= b.cap
      return
    end
    let cap = b.cap * 2
    while cap < b.len + more
      cap = cap * 2
    end
    let data = mem_alloc(cap)
    mem_copy(data, b.data, b.len)
    b.data = data
    b.cap = cap
  end

  fn sb_add(b: ptr StrBuf, s: str)
    sb_reserve(b, len(s))
    mem_copy(mem_add(b.data, b.len), cstr(s), len(s))
    b.len = b.len + len(s)
  end

  fn sb_bytes(b: ptr StrBuf, p: ptr u8, n: int)
    sb_reserve(b, n)
    mem_copy(mem_add(b.data, b.len), p, n)
    b.len = b.len + n
  end

  fn sb_byte(b: ptr StrBuf, c: u8)
    sb_reserve(b, 1)
    *mem_add(b.data, b.len) = c
    b.len = b.len + 1
  end

  fn sb_int(b: ptr StrBuf, n: int)
    sb_add(b, str_from_int(n))
  end

  fn sb_len(b: ptr StrBuf) -> int
    return b.len
  end

  fn sb_str(b: ptr StrBuf) -> str
    return str_from(b.data, b.len)
  end

  fn sb_clear(b: ptr StrBuf)
    b.len = 0
  end
